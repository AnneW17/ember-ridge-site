---
// src/components/CTASection.astro — closing invitation used at the foot of pages.
//
// Every content page now passes its own eyebrow/title/body so the closing block
// is specific to what the reader just finished. The defaults below are a
// fallback only — if you see them rendering, a page is missing its props.
interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
}
const {
  eyebrow = 'The Invitation',
  title = 'Take this before the Lord',
  body = 'Ask whether God is inviting you to pray for this work, to help build it, or to give toward it.',
  primary = { label: 'Partner With Us', href: '/partner' },
  secondary = { label: 'Pray With Us', href: '/house-of-prayer#intercession' },
} = Astro.props;
---
<section class="band-ink on-ink relative overflow-hidden border-t border-gold-600/30">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="glow-gold-soft animate-breathe absolute bottom-[-16rem] left-1/2 h-[34rem] w-[34rem]
                -translate-x-1/2 rounded-full blur-3xl [will-change:opacity,transform]"></div>
  </div>
  <div class="shell relative py-20 sm:py-28">
    <div data-reveal class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="display-2 mt-4">{title}</h2>
      <div class="rule-gold mx-auto mt-6"></div>
      <p class="mt-7 text-[1.0625rem] leading-relaxed text-cream-dark">{body}</p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={primary.href} class="btn-gold w-full sm:w-auto">{primary.label}</a>
        <a href={secondary.href} class="btn w-full border border-cream-dark/45 text-ivory transition-colors duration-300 hover:border-gold-300 hover:text-gold-300 sm:w-auto">{secondary.label}</a>
      </div>
    </div>
  </div>
</section>
