---
// src/components/Header.astro
// Fixed header. Transparent over the hero, then settles into a solid
// charcoal bar on scroll. Mobile menu is keyboard accessible and closes on Escape.
import { nav, site } from '../data/site';

interface Props { theme?: 'dark' | 'cream'; }
const { theme = 'dark' } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header
  id="site-header"
  data-theme={theme}
  class:list={[
    'fixed inset-x-0 top-0 z-50 transition-all duration-500 [transition-timing-function:var(--ease-refined)]',
    theme === 'cream' && 'bg-ink/95 backdrop-blur-md',
  ]}
>
  <div class="shell">
    <div
      id="header-inner"
      class="flex items-center justify-between border-b border-transparent py-5 transition-all duration-500"
    >
      <!-- Ember Ridge is primary; Firebrand is the auxiliary attribution. -->
      <a href="/" class="group flex items-center gap-3.5" aria-label={`${site.name} — home`}>
        <img
          src="/images/ember-ridge-logo-dark.png"
          alt=""
          width="640"
          height="640"
          class="h-10 w-auto opacity-95 transition-opacity duration-300 group-hover:opacity-100 sm:h-11"
        />
        <span class="flex flex-col leading-none">
          <span class="font-display text-lg tracking-[0.16em] text-cream sm:text-xl">EMBER RIDGE</span>
          <span class="mt-1 font-sans text-[0.5625rem] uppercase tracking-[0.2em] text-stone-500">
            A Ministry of Firebrand Revivalists
          </span>
        </span>
      </a>

      <!-- Desktop navigation -->
      <nav aria-label="Main" class="hidden items-center gap-8 lg:flex">
        {nav.filter((i) => i.label !== 'Partner').map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class:list={[
              'relative py-1 font-sans text-[0.8125rem] uppercase tracking-[0.14em] transition-colors duration-300',
              'after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-gold-500 after:transition-transform after:duration-300 hover:after:scale-x-100',
              isCurrent(item.href) ? 'text-gold-400 after:scale-x-100' : 'text-stone-300 hover:text-cream',
            ]}
          >
            {item.label}
          </a>
        ))}
        <a href="/partner" class="btn-primary !px-6 !py-3 !text-[0.75rem]">Partner With Us</a>
      </nav>

      <!-- Mobile trigger -->
      <button
        id="menu-toggle"
        type="button"
        class="-mr-2 flex h-11 w-11 items-center justify-center text-cream lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">Open menu</span>
        <svg id="icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <svg id="icon-close" class="hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.4" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    hidden
    class="border-t border-charcoal-300 bg-ink/98 backdrop-blur-md lg:hidden"
  >
    <nav aria-label="Mobile" class="shell flex flex-col py-6">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
          class:list={[
            'border-b border-charcoal-300/70 py-4 font-display text-xl transition-colors',
            isCurrent(item.href) ? 'text-gold-400' : 'text-cream hover:text-gold-300',
          ]}
        >
          {item.label}
        </a>
      ))}
      <a href="/partner" class="btn-primary mt-7 w-full">Partner With Us</a>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.getElementById('site-header');
    const inner = document.getElementById('header-inner');
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');
    if (!header || !inner || !toggle || !menu) return;

    // Legal pages sit on a cream surface, so the header stays solid there.
    const solidAlways = header.dataset.theme === 'cream';
    const solid = ['bg-ink/95', 'backdrop-blur-md'];
    const onScroll = () => {
      const past = solidAlways || window.scrollY > 24;
      header.classList.toggle(solid[0], past);
      header.classList.toggle(solid[1], past);
      inner.classList.toggle('border-charcoal-300', past);
      inner.classList.toggle('py-3', past);
      inner.classList.toggle('py-5', !past);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    const setOpen = (open) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };

    toggle.addEventListener('click', () => setOpen(menu.hidden));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) { setOpen(false); toggle.focus(); }
    });
    window.addEventListener('resize', () => { if (window.innerWidth >= 1024) setOpen(false); });
  })();
</script>
