---
// src/components/ContactForm.astro
//
// Netlify Forms. The `data-netlify` attribute is all that is required — Netlify
// detects the form in the deployed HTML at build time. Submissions are stored
// in the dashboard under Forms → ember-ridge-inquiry.
//
// DELIVERY TO info@firebrandrevivalists.com IS A DASHBOARD SETTING, NOT CODE:
//   Netlify → Site configuration → Forms → Form notifications
//   → Add notification → Email notification
//   → Event: New form submission · Form: ember-ridge-inquiry
//   → Email to notify: info@firebrandrevivalists.com
// This has to be done once after the first deploy. See README §4.
//
// Honeypot field ("bot-field") is enabled for spam filtering.
const inputBase =
  'w-full border border-stone-200 bg-cream px-4 py-3.5 font-sans text-[0.9375rem] text-ink ' +
  'placeholder:text-stone-600 transition-colors duration-300 focus:border-gold-600 focus:outline-none ' +
  'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-400';
const labelBase = 'block font-sans text-[0.6875rem] uppercase tracking-[0.16em] text-stone-700';
---

<form
  name="ember-ridge-inquiry"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  action="/contact/thank-you"
  class="space-y-7"
>
  <!-- Netlify honeypot: hidden from people, tempting to bots. -->
  <p class="hidden">
    <label>Don’t fill this out if you’re human: <input name="bot-field" tabindex="-1" /></label>
  </p>

  <div class="grid gap-7 sm:grid-cols-2">
    <div>
      <label class={labelBase} for="name">Name <span class="text-gold-700">*</span></label>
      <input class:list={[inputBase, 'mt-2.5']} type="text" id="name" name="name" required autocomplete="name" />
    </div>
    <div>
      <label class={labelBase} for="email">Email <span class="text-gold-700">*</span></label>
      <input class:list={[inputBase, 'mt-2.5']} type="email" id="email" name="email" required autocomplete="email" />
    </div>
  </div>

  <div class="grid gap-7 sm:grid-cols-2">
    <div>
      <label class={labelBase} for="organization">Church, ministry, or organization</label>
      <input class:list={[inputBase, 'mt-2.5']} type="text" id="organization" name="organization" autocomplete="organization" />
    </div>
    <div>
      <label class={labelBase} for="reason">Reason for reaching out <span class="text-gold-700">*</span></label>
      <select class:list={[inputBase, 'mt-2.5']} id="reason" name="reason" required>
        <option value="">Please choose…</option>
        <option>Prayer request</option>
        <option>I would like to intercede for Ember Ridge</option>
        <option>Partnership or giving inquiry</option>
        <option>Offering professional expertise</option>
        <option>Referral for a leader or ministry family</option>
        <option>General inquiry</option>
      </select>
    </div>
  </div>

  <div>
    <label class={labelBase} for="message">
      How can we pray, or how would you like to help? <span class="text-gold-700">*</span>
    </label>
    <textarea class:list={[inputBase, 'mt-2.5 min-h-40 resize-y']} id="message" name="message" rows="6" required></textarea>
  </div>

  <fieldset class="border-0 p-0">
    <legend class="sr-only">Confidentiality</legend>
    <label class="flex items-start gap-3 text-sm leading-relaxed text-stone-700">
      <input
        type="checkbox"
        name="confidential"
        value="Requested confidential handling"
        class="mt-1.5 h-4 w-4 shrink-0 accent-[var(--color-gold-600)]"
      />
      <span>Please treat this message as confidential and limit it to leadership.</span>
    </label>
  </fieldset>

  <p class="text-xs leading-relaxed text-stone-600">
    Submitting this form does not create a legal, pastoral, counseling, or
    professional relationship, and messages are not monitored continuously. If
    you are in immediate danger or crisis, please contact local emergency
    services. See our <a href="/legal/disclaimer" class="link-gold">Disclaimer</a>
    and <a href="/legal/privacy-policy" class="link-gold">Privacy Policy</a>.
  </p>

  <button type="submit" class="btn-gold w-full sm:w-auto">Send message</button>
</form>
