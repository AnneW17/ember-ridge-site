---
// src/components/PageHero.astro — interior page masthead, warm and light.
interface Props { eyebrow: string; title: string; lede?: string; }
const { eyebrow, title, lede } = Astro.props;
---
<section class="surface-warm relative overflow-hidden border-b border-stone-200 pt-36 pb-16 sm:pt-44 sm:pb-24">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="glow-gold-soft animate-breathe absolute left-1/2 top-[-22rem] h-[40rem] w-[40rem]
                max-w-[140vw] -translate-x-1/2 rounded-full blur-[80px] [will-change:opacity,transform]"></div>
  </div>
  <div aria-hidden="true" class="grain pointer-events-none absolute inset-0"></div>

  <div class="shell relative">
    <div data-reveal class="max-w-3xl">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="display-1 mt-5">{title}</h1>
      <div class="brushed-gold mt-8 h-px w-20"></div>
      {lede && <p class="lede mt-8">{lede}</p>}
    </div>
  </div>
</section>
