---
// src/components/PageHero.astro — interior page masthead.
// Same lighting language as the homepage at a lighter particle density.
import Embers from './Embers.astro';

interface Props { eyebrow: string; title: string; lede?: string; }
const { eyebrow, title, lede } = Astro.props;
---
<section class="surface-matte relative overflow-hidden border-b border-charcoal-300 pt-36 pb-20 sm:pt-44 sm:pb-28">
  <Embers density="light" />

  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute inset-0 bg-[radial-gradient(120%_90%_at_50%_30%,transparent_40%,rgba(8,8,9,0.6)_100%)]"></div>
  </div>
  <div aria-hidden="true" class="grain pointer-events-none absolute inset-0"></div>

  <div class="shell relative">
    <div data-parallax data-parallax-speed="-0.04" class="max-w-3xl">
      <div data-reveal>
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="display-1 text-shadow-deep mt-5">{title}</h1>
        <div class="brushed-gold mt-8 h-px w-20"></div>
        {lede && <p class="lede mt-8">{lede}</p>}
      </div>
    </div>
  </div>
</section>
