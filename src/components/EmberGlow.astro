---
// src/components/EmberGlow.astro
// A candle flame drawn as an asymmetric SVG silhouette — wide, rounded shoulders
// tapering to a tip that leans, with a second lick rising beside it. Deliberately
// off-centre and uneven; symmetry here reads as something else entirely.
// Decorative: aria-hidden, pointer-events-none, still under prefers-reduced-motion.
interface Props {
  variant?: 'bloom' | 'hearth';
}
const { variant = 'bloom' } = Astro.props;
const place = variant === 'hearth' ? 'bottom-[-2rem]' : 'top-1/2 -translate-y-1/2';
---
<div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
  <!-- Light thrown into the room -->
  <div
    class:list={[
      'absolute left-1/2 h-[34rem] w-[58rem] max-w-[160vw] -translate-x-1/2 rounded-full blur-[120px]',
      'animate-ember-halo [will-change:opacity,transform]',
      variant === 'hearth' ? 'bottom-[-26%]' : 'top-1/2 -translate-y-1/2',
    ]}
    style="background: radial-gradient(closest-side, rgba(214,138,42,0.26), rgba(200,162,74,0.12) 56%, rgba(200,162,74,0) 80%);"
  ></div>

  <svg
    class:list={['absolute left-1/2 h-[24rem] w-auto -translate-x-1/2 sm:h-[30rem]', place]}
    viewBox="0 0 240 400"
    fill="none"
    role="presentation"
  >
    <defs>
      <linearGradient id="flameBody" x1="120" y1="40" x2="120" y2="380" gradientUnits="userSpaceOnUse">
        <stop offset="0%"   stop-color="#fff0cf" stop-opacity="0.62" />
        <stop offset="30%"  stop-color="#ffc266" stop-opacity="0.58" />
        <stop offset="62%"  stop-color="#e8912c" stop-opacity="0.50" />
        <stop offset="100%" stop-color="#7a4212" stop-opacity="0.26" />
      </linearGradient>
      <linearGradient id="flameCore" x1="118" y1="120" x2="118" y2="360" gradientUnits="userSpaceOnUse">
        <stop offset="0%"   stop-color="#fffaf0" stop-opacity="0.78" />
        <stop offset="45%"  stop-color="#ffd98a" stop-opacity="0.62" />
        <stop offset="100%" stop-color="#f0a03a" stop-opacity="0.28" />
      </linearGradient>
      <linearGradient id="flameLick" x1="170" y1="130" x2="170" y2="300" gradientUnits="userSpaceOnUse">
        <stop offset="0%"   stop-color="#ffd08a" stop-opacity="0.44" />
        <stop offset="100%" stop-color="#d6772a" stop-opacity="0.14" />
      </linearGradient>
      <filter id="soften" x="-60%" y="-40%" width="220%" height="200%">
        <feGaussianBlur stdDeviation="13" />
      </filter>
      <filter id="softenCore" x="-60%" y="-40%" width="220%" height="200%">
        <feGaussianBlur stdDeviation="8" />
      </filter>
      <filter id="softenLick" x="-80%" y="-40%" width="260%" height="200%">
        <feGaussianBlur stdDeviation="11" />
      </filter>
    </defs>

    <!-- Main body: broad base, shoulders off to the left, tip curling right -->
    <g class="animate-flame-sway [transform-origin:120px_360px] [will-change:transform]">
      <path
        filter="url(#soften)"
        fill="url(#flameBody)"
        d="M118 372c-38-6-62-38-60-80 2-38 26-58 34-92 6-26-2-44 4-70 10 26 30 34 44 58 4-20 0-34 8-52 2 30 22 44 30 74 10 36 4 78-16 108-12 18-28 46-44 54z"
      />
      <!-- A second lick, shorter and set to the right so the outline never mirrors -->
      <path
        filter="url(#softenLick)"
        fill="url(#flameLick)"
        d="M166 300c-16-14-20-40-12-64 6-18 20-28 24-48 8 22 22 34 24 58 2 28-12 50-36 54z"
      />
      <!-- Hot core, offset left of centre -->
      <path
        filter="url(#softenCore)"
        fill="url(#flameCore)"
        class="animate-flame-inner [transform-origin:116px_350px] [will-change:transform,opacity]"
        d="M114 352c-22-8-32-30-28-56 4-24 20-36 24-60 4 22 18 32 24 54 6 26-2 50-20 62z"
      />
    </g>

    <!-- Embers banked at the base -->
    <ellipse
      cx="120" cy="374" rx="70" ry="16"
      fill="#e87c1c" fill-opacity="0.30"
      filter="url(#soften)"
      class="animate-ember-flicker"
    />
  </svg>

  <!-- Fade the whole thing back into the page -->
  <div class="absolute inset-x-0 top-0 h-28 bg-[linear-gradient(to_bottom,var(--color-linen),transparent)]"></div>
  <div class="absolute inset-x-0 bottom-0 h-28 bg-[linear-gradient(to_top,var(--color-cream),transparent)]"></div>
</div>
