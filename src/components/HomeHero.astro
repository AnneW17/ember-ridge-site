---
// src/components/HomeHero.astro
// Warm, light masthead. The Ember Ridge mark leads, then a plain statement of
// what this is, so a first-time visitor is oriented before they scroll.
import { site } from '../data/site';
---
<section class="surface-warm relative overflow-hidden pt-36 pb-20 sm:pt-44 sm:pb-28">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <div class="glow-gold-soft animate-breathe absolute left-1/2 top-[-26rem] h-[52rem] w-[52rem]
                max-w-[150vw] -translate-x-1/2 rounded-full blur-[90px] [will-change:opacity,transform]"></div>
  </div>
  <div aria-hidden="true" class="grain pointer-events-none absolute inset-0"></div>

  <div class="shell relative">
    <div class="max-w-3xl">
      <img
        data-reveal
        src="/images/ember-ridge-logo.png"
        alt=""
        width="640"
        height="640"
        fetchpriority="high"
        class="h-28 w-auto sm:h-36"
      />

      <p data-reveal data-reveal-delay="80" class="eyebrow mt-10">
        A Ministry of Firebrand Revivalists · {site.location}
      </p>

      <h1 data-reveal data-reveal-delay="150" class="display-1 mt-6">
        Tending the fire God has
        <span class="text-gold-700">entrusted to His people.</span>
      </h1>

      <div data-reveal data-reveal-delay="220" class="brushed-gold mt-9 h-px w-24"></div>

      <p data-reveal data-reveal-delay="280" class="lede mt-9 max-w-2xl">
        Ember Ridge is a house that ministers first to the Lord, restores those who
        carry great responsibility, and sends them back strengthened for the work of
        the Kingdom.
      </p>

      <div data-reveal data-reveal-delay="420" class="mt-11 flex flex-col gap-4 sm:flex-row">
        <a href="/vision" class="btn-gold w-full sm:w-auto">Read the Vision</a>
        <a href="/partner" class="btn-outline w-full sm:w-auto">Partner With Us</a>
      </div>
    </div>
  </div>
</section>
