---
// src/components/HomeHero.astro
// Order, top to bottom: full-width lodge banner → Ember Ridge mark → tagline.
// Nothing overlaps; each element sits in its own row.
import { site } from '../data/site';
---
<section>
  <!-- 1. Full-width banner -->
  <div class="relative w-full overflow-hidden bg-cream-dark pt-[4.5rem] sm:pt-[5rem]">
    <div class="relative h-[46vh] min-h-[260px] w-full sm:h-[58vh] lg:h-[64vh] lg:max-h-[620px]">
      <img
        data-banner
        src="/images/campus/lodge-banner.jpg"
        alt="Restoration concept for the Ember Ridge lodge — timber and stone with a covered wraparound porch at dusk"
        width="640"
        height="297"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 h-[110%] w-full object-cover object-center will-change-transform"
      />
      <!-- Warm wash at the base so the photograph settles into the page -->
      <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-28 bg-[linear-gradient(to_top,var(--color-ivory),transparent)]"></div>
      <span aria-hidden="true" class="brushed-gold absolute inset-x-0 bottom-0 h-px"></span>
    </div>
  </div>

  <!-- 2. Mark  3. Tagline -->
  <div class="band-ivory relative">
    <div class="shell">
      <div class="flex flex-col items-center pt-12 pb-4 text-center sm:pt-16">
        <img
          data-reveal
          src="/images/ember-ridge-logo.png"
          alt="Ember Ridge"
          width="1024"
          height="1024"
          class="h-24 w-auto [filter:drop-shadow(0_10px_24px_rgba(122,90,52,0.22))] sm:h-32"
        />

        <p data-reveal data-reveal-delay="90" class="eyebrow mt-7">
          A Ministry of Firebrand Revivalists · {site.location}
        </p>

        <h1 data-reveal data-reveal-delay="150" class="display-1 mt-5 max-w-4xl">
          A house prepared for the Lord
          <span class="text-gold-700">on a mountain marked by prayer.</span>
        </h1>

        <div data-reveal data-reveal-delay="220" class="brushed-gold mx-auto mt-8 h-px w-24"></div>

        <p data-reveal data-reveal-delay="280" class="lede mt-8 max-w-2xl">
          Ember Ridge ministers first to the Lord — and from that devotion receives
          leaders, prophets, pastors, intercessors, and those carrying the weight of
          ministry, and sends them back strengthened.
        </p>

        <div data-reveal data-reveal-delay="380" class="mt-10 flex flex-col gap-4 pb-2 sm:flex-row">
          <a href="/vision" class="btn-gold w-full sm:w-auto">Read the Vision</a>
          <a href="/house-of-prayer" class="btn-outline w-full sm:w-auto">The First Ministry</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Slow parallax drift on the banner: transform only, rAF-throttled, skipped
  // entirely when reduced motion is requested.
  (() => {
    const img = document.querySelector('[data-banner]');
    if (!img) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let ticking = false;
    const apply = () => {
      const y = window.scrollY;
      if (y < window.innerHeight * 1.3) {
        img.style.transform = 'translate3d(0,' + (y * 0.08).toFixed(2) + 'px,0)';
      }
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(apply); }
    }, { passive: true });
    apply();
  })();
</script>
