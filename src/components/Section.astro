---
// src/components/Section.astro — consistent vertical rhythm + surface tone.
// Tone names are historical; all three are warm light surfaces. `charcoal`
// renders a soft cream band with a hairline of gold along the top edge.
interface Props {
  id?: string;
  tone?: 'ink' | 'charcoal' | 'cream';
  size?: 'default' | 'sm';
  class?: string;
  labelledby?: string;
}
const { id, tone = 'ink', size = 'default', class: className = '', labelledby } = Astro.props;

const tones = {
  ink: 'bg-ivory',
  charcoal: 'lit-edge border-y border-stone-200 bg-[linear-gradient(180deg,var(--color-linen)_0%,var(--color-cream)_100%)]',
  cream: 'surface-cream',
};
---
<section
  id={id}
  aria-labelledby={labelledby}
  class:list={[size === 'sm' ? 'section-sm' : 'section', tones[tone], 'relative', className]}
>
  <slot />
</section>
