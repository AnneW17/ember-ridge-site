---
// src/layouts/LegalLayout.astro
// Cream, plain, high-legibility shell for policy pages.
// Every legal page carries a visible review banner until counsel signs off.
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  /** Human-readable effective date, e.g. "29 July 2026" */
  updated: string;
  intro?: string;
}
const { title, description, updated, intro } = Astro.props;
---
<BaseLayout title={title} description={description} theme="cream">
  <header class="surface-warm border-b border-stone-200 pt-36 pb-16 sm:pt-44 sm:pb-20">
    <div class="shell-tight">
      <p class="font-sans text-[0.6875rem] font-medium uppercase tracking-[0.22em] text-bronze">
        Ember Ridge · Legal
      </p>
      <h1 class="mt-5 font-display text-4xl leading-tight sm:text-5xl">{title}</h1>
      <div class="brushed-gold mt-7 h-px w-16"></div>
      <p class="mt-6 font-sans text-sm text-stone-700">
        Last updated: <time>{updated}</time>
      </p>
      {intro && <p class="mt-6 font-display text-xl leading-relaxed text-stone-700">{intro}</p>}
    </div>
  </header>

  <div class="surface-cream">
    <div class="shell-tight py-14 sm:py-20">
      <article class="legal-doc">
        <slot />
      </article>

      <hr class="my-14 h-px border-0 bg-stone-200" />

      <p class="font-sans text-xs leading-relaxed text-stone-700">
        Questions about this document may be directed to Ember Ridge, a ministry of
        Firebrand Revivalists, Moravian Falls, North Carolina —
        <a href="mailto:info@firebrandrevivalists.com" class="underline">info@firebrandrevivalists.com</a>.
        This document is provided for information and is not legal advice.
      </p>
    </div>
  </div>
</BaseLayout>
