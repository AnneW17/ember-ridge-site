---
// src/layouts/BaseLayout.astro
// Shell for every page: metadata, fonts, skip link, header, footer,
// and the single scroll-reveal observer used site-wide.
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource-variable/inter';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Optional social-share image path, e.g. /images/og/home.jpg */
  ogImage?: string;
  /** Light cream page shell — used by legal pages. */
  theme?: 'dark' | 'cream';
}

const { title, description, ogImage = '/images/ember-ridge-mark.jpg', theme = 'dark' } = Astro.props;

const fullTitle = title === 'Home' ? `${site.name} — ${site.tagline}` : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogUrl = new URL(ogImage, Astro.site ?? site.url).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  alternateName: `${site.name}, a ministry of ${site.parentOrg}`,
  url: site.url,
  logo: new URL('/images/ember-ridge-logo.png', Astro.site ?? site.url).href,
  description: site.mission,
  parentOrganization: { '@type': 'Organization', name: site.parentOrg },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Moravian Falls',
    addressRegion: 'NC',
    addressCountry: 'US',
  },
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#FBF9F4" />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>

  <body class="bg-ivory text-stone-700">
    <a
      href="#main"
      class="sr-only-focusable absolute left-4 top-4 z-[100] bg-ink px-4 py-2 font-sans text-sm font-medium text-ivory"
    >
      Skip to main content
    </a>

    <Header theme={theme} />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script is:inline>
      // Scroll reveal — one observer for the whole page, ~1KB, no dependencies.
      (() => {
        const items = document.querySelectorAll('[data-reveal]');
        if (!items.length) return;

        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          items.forEach((el) => el.classList.add('is-visible'));
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target;
              const delay = Number(el.dataset.revealDelay || 0);
              setTimeout(() => el.classList.add('is-visible'), delay);
              io.unobserve(el);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 }
        );

        items.forEach((el) => io.observe(el));
      })();

    </script>
  </body>
</html>
