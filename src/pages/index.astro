---
// src/pages/index.astro — Home
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import CTASection from '../components/CTASection.astro';
import Reveal from '../components/Reveal.astro';
import EmberGlow from '../components/EmberGlow.astro';

const audience = [
  'Pastors and ministry leaders',
  'Prophets and intercessors',
  'Missionaries and chaplains',
  'Business and marketplace leaders',
  'Educators and public servants',
  'Ministry families',
];

const pillars = [
  {
    numeral: 'I',
    title: 'A House of Prayer',
    body: 'Worship, intercession and consecration are the first work of the house — not the atmosphere around it.',
    href: '/house-of-prayer',
  },
  {
    numeral: 'II',
    title: 'Restoration and Reformation',
    body: 'Leaders and those appointed by the Lord are received without performance, told the truth in love, and given room for the Holy Spirit to work at a depth scheduled gatherings rarely allow.',
    href: '/story',
  },
  {
    numeral: 'III',
    title: 'Shared Life',
    body: 'An Acts 2 rhythm of Scripture, fellowship, shared meals, prayer, and daily faithfulness — because some healing occurs only through proximity.',
    href: '/ministry-model',
  },
  {
    numeral: 'IV',
    title: 'Faithful Sending',
    body: 'What God restores here is not meant to remain on the mountain. People return to their homes, churches, and assignments carrying renewed fire.',
    href: '/ministry-model#sending',
  },
];

const routes = [
  {
    label: 'Pray',
    body: 'Carry this work in intercession — before anything is built, and long after.',
    cta: 'Join the intercession',
    href: '/house-of-prayer',
  },
  {
    label: 'Partner',
    body: 'Bring professional wisdom, materials, or hands to the building of it.',
    cta: 'Ways to partner',
    href: '/partner',
  },
  {
    label: 'Give',
    body: 'Support the purchase, the renovation, and the long-term operating foundation.',
    cta: 'Ways to give',
    href: '/partner#ways-to-give',
  },
];

const campus = [
  'The lodge and great room',
  'The covered porch',
  'The prayer garden',
  'Prayer trails and fire circle',
  'The worship pavilion',
  'The leadership residence',
];
---

<BaseLayout
  title="Home"
  description="Ember Ridge is a house in Moravian Falls, North Carolina that ministers first to the Lord, restores those who carry great responsibility, and sends them back strengthened for the work of the Kingdom. A ministry of Firebrand Revivalists."
>
  <HomeHero />

  <!-- What this is — plain orientation for a first-time visitor -->
  <Section tone="ivory" size="sm" labelledby="orient-heading">
    <div class="shell">
      <Reveal>
        <h2 id="orient-heading" class="display-3 max-w-3xl">
          Ember Ridge is an auxiliary ministry of Firebrand Revivalists&#8482;, a
          Washington nonprofit corporation and a church for federal tax purposes. We are
          working to purchase and operate a lodge in Moravian Falls, North Carolina.
        </h2>
        <div class="prose-body mt-8 max-w-3xl">
          <p>
            The land will be covered in worship and intercession. The lodge will be
            renovated to receive those God appoints, for refreshing, reformation, and
            restoration — and to gather intercessors who will cover this region, the
            nation, families, businesses, and everyone the Lord brings here.
          </p>
        </div>
      </Reveal>
    </div>
  </Section>

  <!-- The need -->
  <Section tone="linen" labelledby="need-heading" class="overflow-hidden">
    <EmberGlow />
    <div class="shell relative grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <Reveal>
          <SectionHeading
            id="need-heading"
            eyebrow="The Founding Vision"
            title="The fire that still remains"
          />
        </Reveal>
      </div>
      <div class="lg:col-span-7">
        <Reveal delay="100" class="prose-body">
          <p>
            Faithful people are carrying burdens few others ever see. Many keep serving
            long after the joy has gone out of it, and there are few places built to
            receive them without asking anything in return.
          </p>
          <p>
            An ember can look spent and still hold living fire. Ember Ridge is being
            formed to tend what God has already lit.
          </p>
          <p class="pt-2">
            <a href="/vision" class="btn-quiet">Read the founding vision →</a>
          </p>
        </Reveal>
      </div>
    </div>
  </Section>

  <!-- Four pillars -->
  <Section tone="cream" labelledby="pillars-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="pillars-heading"
          eyebrow="The Order of Ministry"
          title="Four convictions that shape the house"
          align="center"
        />
      </Reveal>
      <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {pillars.map((p, i) => (
          <Reveal delay={i * 90}>
            <Card numeral={p.numeral} title={p.title}>
              <p>{p.body}</p>
              <p class="mt-5">
                <a href={p.href} class="btn-quiet !text-[0.6875rem] !tracking-[0.16em]">Learn more →</a>
              </p>
            </Card>
          </Reveal>
        ))}
      </div>
    </div>
  </Section>


  <!-- Who this is for -->
  <Section tone="stone" labelledby="audience-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="audience-heading"
          eyebrow="Who This Is For"
          title="Those carrying the weight of ministry"
          align="center"
        />
      </Reveal>

      <ul class="mx-auto mt-14 flex max-w-4xl flex-wrap items-center justify-center gap-x-6 gap-y-4 sm:gap-x-8">
        {audience.map((who, i) => (
          <li data-reveal data-reveal-delay={i * 70} class="flex items-center gap-6 sm:gap-8">
            {i > 0 && <span aria-hidden="true" class="h-1 w-1 rounded-full bg-gold-600/70"></span>}
            <span class="font-display text-xl text-ink sm:text-2xl">{who}</span>
          </li>
        ))}
      </ul>

      <Reveal delay={200} class="mt-12 text-center">
        <p class="mx-auto max-w-2xl text-[0.9375rem] leading-relaxed text-stone-700">
          Placements are limited and prayerfully discerned rather than publicly marketed.
          <a href="/ministry-model" class="link-gold">How the ministry works</a>.
        </p>
      </Reveal>
    </div>
  </Section>

  <!-- The lodge is not a venue -->
  <Section tone="ivory">
    <div class="shell">
      <blockquote data-reveal>
        <p class="pullquote-feature">
          The lodge is not a venue. It is the next room in our family home, made larger
          so that more sons and daughters can come in.
        </p>
      </blockquote>
    </div>
  </Section>

  <!-- The Place -->
  <Section tone="linen" labelledby="place-heading">
    <div class="shell grid items-center gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <Reveal>
          <SectionHeading
            id="place-heading"
            eyebrow="The Place"
            title="Why Moravian Falls"
            lede="Generations have prayed on this mountain. Ember Ridge is being formed to honor what God has already done here, and to keep tending it."
          />
          <p class="mt-6">
            <a href="/the-place" class="btn-quiet">The history of the land →</a>
          </p>
        </Reveal>
      </div>

      <div class="lg:col-span-6">
        <Reveal delay={120}>
          <figure>
            <div class="overflow-hidden border border-stone-200 bg-cream shadow-[var(--shadow-lift-lg)]">
              <img
                src="/images/campus/lodge-concept.jpg"
                alt="Restoration concept for the Ember Ridge lodge — timber and stone with a covered wraparound porch"
                width="1836"
                height="857"
                loading="lazy"
                decoding="async"
                class="w-full object-cover"
              />
            </div>
            <figcaption class="mt-4 text-xs leading-relaxed text-stone-600">
              Restoration concept — not the property in its current condition.
            </figcaption>
          </figure>

          <p class="eyebrow mt-10">What Is Being Built</p>
          <ul class="mt-5 grid gap-x-8 gap-y-2.5 sm:grid-cols-2">
            {campus.map((item) => (
              <li class="flex items-start gap-3 text-[0.9375rem] text-ink">
                <span aria-hidden="true" class="mt-2 h-1 w-1 shrink-0 rounded-full bg-gold-500"></span>
                {item}
              </li>
            ))}
          </ul>
          <p class="mt-8">
            <a href="/remodel-and-grounds" class="btn-quiet">Explore remodel and grounds →</a>
          </p>
        </Reveal>
      </div>
    </div>
  </Section>


  <!-- How to take part -->
  <Section tone="cream" labelledby="take-part-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="take-part-heading"
          eyebrow="How to Take Part"
          title="Three ways in"
          align="center"
        />
      </Reveal>

      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {routes.map((r, i) => (
          <Reveal delay={i * 90}>
            <article class="card card-lift flex h-full flex-col text-center">
              <h3 class="font-display text-2xl text-ink">{r.label}</h3>
              <div class="brushed-gold mx-auto mt-4 h-px w-10"></div>
              <p class="mt-5 flex-1 text-[0.9375rem] leading-relaxed text-stone-700">{r.body}</p>
              <p class="mt-7">
                <a href={r.href} class="btn-quiet !text-[0.6875rem] !tracking-[0.16em]">{r.cta} →</a>
              </p>
            </article>
          </Reveal>
        ))}
      </div>
    </div>
  </Section>

  <CTASection
    eyebrow="Where to Start"
    title="Begin with the vision"
    body="The next step is not a decision. It is a reading. Take the founding vision before the Lord and see what He says."
    primary={{ label: 'Read the Vision', href: '/vision' }}
    secondary={{ label: 'Meet the leadership', href: '/leadership' }}
  />
</BaseLayout>
