---
// src/pages/index.astro — Home
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import CTASection from '../components/CTASection.astro';
import Reveal from '../components/Reveal.astro';
import EmberGlow from '../components/EmberGlow.astro';

const pillars = [
  {
    numeral: 'I',
    title: 'A House of Prayer',
    body: 'Before Ember Ridge ministers to people, it ministers to God — through worship, intercession, consecration, and attentive obedience.',
    href: '/house-of-prayer',
  },
  {
    numeral: 'II',
    title: 'Restoration and Reformation',
    body: 'Leaders and those appointed by the Lord are received without performance, told the truth in love, and given room for the Holy Spirit to work at a depth scheduled gatherings rarely allow.',
    href: '/story',
  },
  {
    numeral: 'III',
    title: 'Shared Life',
    body: 'An Acts 2 rhythm of Scripture, fellowship, shared meals, prayer, and daily faithfulness — because some healing occurs only through proximity.',
    href: '/ministry-model',
  },
  {
    numeral: 'IV',
    title: 'Faithful Sending',
    body: 'What God restores here is not meant to remain on the mountain. People return to their homes, churches, and assignments carrying renewed fire.',
    href: '/ministry-model#sending',
  },
];

const campus = [
  'The lodge and great room',
  'The covered porch',
  'The prayer garden',
  'Prayer trails and fire circle',
  'The worship pavilion',
  'The leadership residence',
];
---

<BaseLayout
  title="Home"
  description="Ember Ridge is a house in Moravian Falls, North Carolina that ministers first to the Lord, restores those who carry great responsibility, and sends them back strengthened for the work of the Kingdom. A ministry of Firebrand Revivalists."
>
  <HomeHero />

  <!-- What this is — plain orientation for a first-time visitor -->
  <Section tone="ivory" size="sm" labelledby="orient-heading">
    <div class="shell">
      <Reveal>
        <h2 id="orient-heading" class="display-3 max-w-3xl">
          Ember Ridge is a ministry of Firebrand Revivalists. We are working to purchase
          and operate a lodge in Moravian Falls, North Carolina.
        </h2>
        <div class="prose-body mt-8 max-w-3xl">
          <p>
            First and foremost, Ember Ridge is a ministry to the Lord — a place where the
            land is covered in worship and intercession. The lodge will be renovated to
            receive those God appoints, for refreshing, reformation, and restoration.
          </p>
          <p>
            It will also gather intercessors to cover this region, the nation, families,
            businesses, and everyone the Lord brings to Ember Ridge.
          </p>
        </div>
      </Reveal>

      <div class="mt-12 grid gap-8 sm:grid-cols-3">
        <Reveal>
          <p class="eyebrow">The Place</p>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-stone-700">
            A lodge on eleven acres in Moravian Falls, renovated to receive those the
            Lord appoints for prayer, refreshing, reformation and restoration.
          </p>
        </Reveal>
        <Reveal delay={90}>
          <p class="eyebrow">The Work</p>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-stone-700">
            Worship and intercession first — and from that place, refreshing for leaders,
            prophets, pastors, intercessors, and those carrying the weight of ministry.
          </p>
        </Reveal>
        <Reveal delay={180}>
          <p class="eyebrow">How to Take Part</p>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-stone-700">
            Pray with us, partner with us, or give toward the purchase and renovation.
            <a href="/partner" class="link-gold"> Start here</a>.
          </p>
        </Reveal>
      </div>
    </div>
  </Section>

  <!-- The need -->
  <Section tone="linen" labelledby="need-heading" class="overflow-hidden">
    <EmberGlow variant="bloom" />
    <div class="shell relative grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <Reveal>
          <SectionHeading
            id="need-heading"
            eyebrow="The Founding Vision"
            title="The fire that still remains"
          />
        </Reveal>
      </div>
      <div class="lg:col-span-7">
        <Reveal delay="100" class="prose-body">
          <p>
            Across churches, ministries, schools, businesses, communities, and
            public life, faithful people are carrying burdens few others ever see.
            Pastors shepherd while navigating cultural pressure and private warfare.
            Missionaries pour themselves out far from familiar support. Intercessors
            stand in the gap for others, often without anyone recognizing the cost of
            that hidden service.
          </p>
          <p>
            Ember Ridge is first and foremost a home devoted to the Lord. It is a
            place where leaders and those carrying heavy responsibilities can come to
            be refreshed, reformed, restored, and renewed in His presence. It is also
            a place of faithful prayer, where intercessors gather to seek the Lord and
            stand in the gap for our region, our nation, and the world.
          </p>
          <p>
            An ember can appear small, buried, or nearly spent, yet it still holds
            living fire. When protected, nourished, and given breath, it can burn
            brightly again.
          </p>
          <p class="pt-2">
            <a href="/vision" class="btn-quiet">Read the founding vision →</a>
          </p>
        </Reveal>
      </div>
    </div>
  </Section>

  <!-- Four pillars -->
  <Section tone="cream" labelledby="pillars-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="pillars-heading"
          eyebrow="The Order of Ministry"
          title="Four convictions that shape the house"
          align="center"
        />
      </Reveal>
      <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {pillars.map((p, i) => (
          <Reveal delay={i * 90}>
            <Card numeral={p.numeral} title={p.title}>
              <p>{p.body}</p>
              <p class="mt-5">
                <a href={p.href} class="btn-quiet !text-[0.6875rem] !tracking-[0.16em]">Learn more →</a>
              </p>
            </Card>
          </Reveal>
        ))}
      </div>
    </div>
  </Section>

  <!-- The lodge is not a venue -->
  <Section tone="stone">
    <div class="shell">
      <blockquote data-reveal class="mx-auto max-w-3xl text-center">
        <p class="pullquote">
          The lodge is not a venue. It is the next room in our family home, made larger
          so that more sons and daughters can come in.
        </p>
      </blockquote>
    </div>
  </Section>

  <!-- The Place -->
  <Section tone="stone" labelledby="place-heading">
    <div class="shell grid items-center gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <Reveal>
          <SectionHeading
            id="place-heading"
            eyebrow="The Place"
            title="A land marked by prayer"
            lede="Ember Ridge will stand within a wider spiritual story — one shaped by the Moravian witness, the history of Prayer Mountain, and generations of people who gave themselves to God."
          />
          <p class="mt-8 max-w-xl text-[1.0625rem] leading-relaxed text-stone-700">
            In 1727 the community at Herrnhut established a continual prayer watch
            that endured for more than a hundred years and helped fuel one of the
            most influential missionary movements in Church history. When Moravians
            later settled in North Carolina, they carried that disciplined life of
            prayer, work, worship, and stewardship into the region.
          </p>
          <p class="mt-6">
            <a href="/the-place" class="btn-quiet">Moravian Falls &amp; Prayer Mountain →</a>
          </p>
        </Reveal>
      </div>

      <div class="lg:col-span-6">
        <Reveal delay="120" class="card !border-stone-200 !bg-cream !p-9 sm:!p-11">
          <p class="eyebrow">The Campus Vision</p>
          <h3 class="display-3 mt-4">A place designed to serve the mission</h3>
          <p class="mt-5 text-[0.9375rem] leading-relaxed text-stone-700">
            Every renovation, building, and outdoor space is evaluated by one
            question: does it help people minister to the Lord, live in healthy
            community, and be restored for faithful service?
          </p>
          <ul class="mt-8 grid gap-x-8 gap-y-3 sm:grid-cols-2">
            {campus.map((item) => (
              <li class="flex items-start gap-3 text-sm text-ink">
                <span aria-hidden="true" class="mt-2 h-1 w-1 shrink-0 rounded-full bg-gold-500"></span>
                {item}
              </li>
            ))}
          </ul>
          <p class="mt-9">
            <a href="/remodel-and-grounds" class="btn-quiet">Explore remodel and grounds →</a>
          </p>
        </Reveal>
      </div>
    </div>
  </Section>

  <!-- Trust -->
  <Section tone="ivory" size="sm" labelledby="trust-heading">
    <div class="shell">
      <Reveal class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Leadership &amp; Stewardship</p>
        <h2 id="trust-heading" class="display-3 mt-4">
          Family-lived, professionally governed, and accountable.
        </h2>
        <p class="mt-7 text-[1.0625rem] leading-relaxed text-stone-700">
          Faith and financial responsibility are not opposing values. The spiritual
          nature of this assignment will never be used to avoid practical
          accountability.
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="/leadership" class="btn-outline w-full sm:w-auto">Meet the leadership</a>
          <a href="/financial-stewardship" class="btn-outline w-full sm:w-auto">Financial stewardship</a>
        </div>
      </Reveal>
    </div>
  </Section>

  <CTASection />
</BaseLayout>
