---
// src/pages/leadership.astro — Leadership and Accountability
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import LeadershipTeam from '../components/LeadershipTeam.astro';
import Reveal from '../components/Reveal.astro';
import CTASection from '../components/CTASection.astro';
import { ministryStaff } from '../data/leadership';

// Sibling ministries under Firebrand Revivalists, shown alongside it below.
// Firebrand itself is rendered separately as the parent/anchor entry.
const ministryFamily = [
  {
    name: 'Jesus Loves the Little Children',
    role: 'School Chaplaincy',
    description:
      'Trained chaplains serving directly in schools — ministering to children, families, and staff through prayer, encouragement, and biblical guidance.',
    href: 'https://www.firebrandrevivalists.com/jllc',
    domain: 'firebrandrevivalists.com/jllc',
    logo: '/images/jllc-logo.jpg',
  },
  {
    name: 'Generational Legacy Foundation',
    role: 'Philanthropic Ministry',
    description:
      'A philanthropic ministry of Firebrand Revivalists, giving practical expression to generosity and stewardship across generations.',
    href: 'https://thegenerationallegacy.org',
    domain: 'thegenerationallegacy.org',
    logo: '/images/generational-legacy-logo.png',
  },
];

const governance = [
  'Board-approved budgets',
  'Documented authority',
  'Conflict-of-interest standards',
  'Contracts for significant work',
  'Donor restrictions honored in accounting',
  'Appropriate insurance',
  'Background and safety policies',
  'Confidentiality requirements',
  'Professional review of acquisition, construction, and employment practices',
  'Licensed contractors and specialists where required',
];

---

<BaseLayout
  title="Leadership & Accountability"
  description="Ember Ridge is family-lived, professionally governed, and accountable. Meet the leadership team and review the governance standards of the ministry."
>
  <PageHero
    eyebrow="Leadership & Accountability"
    title="A Family Called to Steward, a Ministry Built to Endure"
    lede="Ember Ridge will be family-lived, professionally governed, and accountable."
  />

  <!-- Leadership Team -->
  <Section tone="ivory" labelledby="team-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="team-heading"
          eyebrow="The Leadership Team"
          title="Those entrusted with the house"
          lede="Ember Ridge is an auxiliary ministry of Firebrand Revivalists&#8482;. Each leader below carries both a spiritual assignment and a defined professional responsibility."
        />
      </Reveal>

      <Reveal class="mt-14">
        <h3 id="ministry-team-heading" class="eyebrow">Ministry Leadership Team</h3>
        <div class="brushed-gold mt-4 h-px w-14"></div>
      </Reveal>

      <div class="mt-10">
        <LeadershipTeam headingLevel={4} />
      </div>


      <div class="mt-8">
        <LeadershipTeam people={ministryStaff} headingLevel={4} idPrefix="staff-bio" />
      </div>
    </div>
  </Section>

  <!-- Firebrand Revivalists & the family of ministries -->
  <Section tone="ink" labelledby="family-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="family-heading"
          eyebrow="Part of a Larger Work"
          title="Firebrand Revivalists &amp; Its Family of Ministries"
          lede="Ember Ridge is one expression of a wider work God is building. Each ministry below is entrusted to the same leadership and carries its own calling."
        />
      </Reveal>

      <!-- Firebrand Revivalists — the parent ministry -->
      <Reveal delay={80} class="mt-14">
        <div class="grid items-center gap-10 border border-white/10 bg-white/[0.03] p-10 sm:p-12 lg:grid-cols-12 lg:gap-14">
          <div class="flex justify-center lg:col-span-4 lg:justify-start">
            <img
              src="/images/firebrand-logo-dark.png"
              alt="Firebrand Revivalists"
              width="640"
              height="640"
              loading="lazy"
              decoding="async"
              class="h-40 w-auto sm:h-48"
            />
          </div>
          <div class="lg:col-span-8">
            <p class="font-sans text-[0.625rem] uppercase tracking-[0.28em] text-gold-300">
              The Parent Ministry
            </p>
            <p class="mt-5 text-[1.0625rem] leading-relaxed" style="color:var(--color-cream-dark);">
              Firebrand Revivalists&#8482; is the ministry that oversees this work —
              igniting hearts, awakening destiny, and reviving glory across every
              ministry entrusted to it, Ember Ridge included.
            </p>
            <p class="mt-8">
              <a
                href="https://www.firebrandrevivalists.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-gold !text-[0.75rem]"
              >
                Visit firebrandrevivalists.com
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="ml-1">
                  <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </p>
          </div>
        </div>
      </Reveal>

      <!-- Sibling ministries -->
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        {ministryFamily.map((m, i) => (
          <Reveal delay={160 + i * 90}>
            <div class="flex h-full flex-col border border-white/10 bg-white/[0.03] p-8 sm:p-9">
              <div class="flex items-center gap-5">
                <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-sm bg-white p-2.5 ring-1 ring-white/10">
                  <img
                    src={m.logo}
                    alt={m.name}
                    width="200"
                    height="200"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-contain"
                  />
                </div>
                <div>
                  <p class="font-sans text-[0.625rem] uppercase tracking-[0.2em] text-gold-300">
                    {m.role}
                  </p>
                  <h3 class="mt-1 font-display text-xl text-ivory">{m.name}</h3>
                </div>
              </div>
              <p class="mt-6 flex-1 text-[0.9375rem] leading-relaxed" style="color:var(--color-cream-dark);">
                {m.description}
              </p>
              <p class="mt-7">
                <a
                  href={m.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn border border-gold-500/60 text-gold-300 !px-5 !py-3 !text-[0.6875rem]"
                >
                  Visit {m.domain}
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="ml-1">
                    <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2"
                          stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              </p>
            </div>
          </Reveal>
        ))}
      </div>
    </div>
  </Section>

  <!-- Serving in the Marketplace -->
  <Section tone="linen" labelledby="sophion-heading">
    <div class="shell">
      <Reveal>
        <div class="sophion relative overflow-hidden p-10 shadow-[var(--shadow-lift-lg)] sm:p-14">
          <span aria-hidden="true"
                class="absolute inset-x-0 top-0 h-px"
                style="background-image:linear-gradient(to right,transparent,rgb(200 162 74 / 0.7),transparent);"></span>

          <div class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-14">
            <div class="lg:col-span-7">
              <p class="eyebrow">Serving in the Marketplace</p>
              <h2 id="sophion-heading" class="display-3 mt-4">
                Sophion Media and Consulting Group
              </h2>
              <div class="mt-6 h-px w-16"
                   style="background-image:linear-gradient(to right,var(--sophion-gold),transparent);"></div>

              <div class="mt-7 space-y-5 text-[1.0625rem] leading-relaxed" style="color:#c9d6d8;">
                <p>
                  The family’s marketplace work through Sophion Media &amp; Consulting
                  Group complements this mission by strengthening leaders and
                  organizations through advisory, legal-operations, strategy, media, and
                  consulting services.
                </p>
                <p>
                  Sophion’s work may support the larger vision through properly structured
                  contributions and services.
                </p>
              </div>

              <p class="mt-9">
                <a
                  href="https://www.sophionhq.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn border text-[0.75rem]"
                  style="border-color:var(--sophion-gold);color:var(--sophion-gold);"
                >
                  Visit sophionhq.com
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="ml-1">
                    <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2"
                          stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              </p>
            </div>

            <div class="lg:col-span-5">
              <div class="flex items-center justify-center">
                <img
                  src="/images/sophion-logo.png"
                  alt="Sophion Media &amp; Consulting Group"
                  width="287"
                  height="345"
                  loading="lazy"
                  decoding="async"
                  class="h-48 w-auto sm:h-56 lg:h-64"
                />
              </div>
            </div>
          </div>
        </div>
      </Reveal>
    </div>
  </Section>

  <!-- Governance -->
  <Section id="governance" tone="cream" labelledby="governance-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="governance-heading"
          eyebrow="Governance"
          title="The spiritual nature of the assignment will never be used to avoid practical accountability"
        />
      </Reveal>

      <Reveal delay="100" class="mt-14 grid gap-x-10 gap-y-4 sm:grid-cols-2">
        {governance.map((item) => (
          <div class="flex items-start gap-4 border-l border-stone-200 py-1 pl-5">
            <span aria-hidden="true" class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-gold-500"></span>
            <p class="text-[0.9375rem] leading-relaxed text-ink">{item}</p>
          </div>
        ))}
      </Reveal>
    </div>
  </Section>

  <CTASection
    title="Partner with this work"
    body="Governance depends on people willing to lend real expertise. If you carry professional skill that could serve this work, we would welcome the conversation."
    primary={{ label: 'Ways to partner', href: '/partner#partner' }}
    secondary={{ label: 'Contact leadership', href: '/contact' }}
  />
</BaseLayout>
