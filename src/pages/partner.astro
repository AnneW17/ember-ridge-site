---
// src/pages/partner.astro — Invitation / Partner With Us
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Prose from '../components/Prose.astro';
import PullQuote from '../components/PullQuote.astro';
import Callout from '../components/Callout.astro';
import Reveal from '../components/Reveal.astro';
import WaysToGive from '../components/WaysToGive.astro';

const ways = [
  {
    id: 'pray',
    numeral: 'I',
    title: 'Pray',
    body: 'Some are called to pray before they are called to anything else. Intercessors carry this work through acquisition, construction, transition and opening — and stand with the region, the nation, and everyone the Lord brings here.',
    cta: 'Join the intercession',
    href: '/house-of-prayer#intercession',
  },
  {
    id: 'partner',
    numeral: 'II',
    title: 'Partner',
    body: 'Serving, professional expertise, ministry collaboration, materials and labour, and introductions to others carrying a corresponding assignment. Architecture, engineering, construction, finance, law, hospitality, security, technology and landscaping are all needed.',
    cta: 'Start a conversation',
    href: '/contact',
  },
  {
    id: 'way-give',
    numeral: 'III',
    title: 'Give',
    body: 'Financial support toward the purchase, the renovation, the cabins and grounds, the intercession team, and the long-term operating foundation.',
    cta: 'Ways to give',
    href: '#give',
  },
];
---

<BaseLayout
  title="Partner With Us"
  description="Ember Ridge is an invitation to pray, build, give, serve, or connect — helping establish a house where the presence of God strengthens generations."
>
  <PageHero
    eyebrow="The Invitation"
    title="Tend the Fire With Us"
    lede="Ember Ridge is an invitation to help establish a place where the presence of God, healthy family, sustained intercession, and faithful stewardship can strengthen generations."
  />

  <Section tone="ivory" labelledby="ways-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="ways-heading"
          eyebrow="Three Ways to Engage"
          title="Three ways to be part of what God is doing"
        />
      </Reveal>

      <div class="mt-16 grid gap-6 md:grid-cols-3">
        {ways.map((way, i) => (
          <Reveal delay={(i % 3) * 90}>
            <article id={way.id} class="card card-lift flex h-full scroll-mt-32 flex-col">
              <p class="card-numeral">{way.numeral}</p>
              <h3 class="mt-3 font-display text-2xl text-ink">{way.title}</h3>
              <div class="rule-gold mt-5"></div>
              <p class="mt-5 flex-1 text-[0.9375rem] leading-relaxed text-stone-700">{way.body}</p>
              <p class="mt-7">
                <a href={way.href} class="btn-quiet !text-[0.6875rem] !tracking-[0.16em]">{way.cta} →</a>
              </p>
            </article>
          </Reveal>
        ))}
      </div>
    </div>
  </Section>

  <Section tone="linen">
    <div class="shell">
      <Reveal class="mx-auto max-w-3xl">
        <SectionHeading
          eyebrow="Our Hope"
          title="What we are asking God for"
          align="center"
        />
        <div class="mt-12 prose-body mx-auto max-w-[42rem]">
          <p>
            Our hope is that one day leaders will arrive at Ember Ridge carrying burdens
            too heavy to keep carrying alone. They will be welcomed around a table,
            covered in prayer, restored in God’s presence, strengthened within healthy
            relationship, and sent home with renewed fire.
          </p>
          <p>
            Intercessors will minister before the Lord with dignity, accountability, and
            the practical support needed for sustained service. Children will grow up
            seeing faith lived honestly. Worship will rise from the mountain in seasons of
            quiet devotion and seasons of day-and-night prayer.
          </p>
          <p>
            Families, churches, businesses, schools, and communities will be strengthened
            because someone was given room to heal and hear God again.
          </p>
        </div>

        <PullQuote>
          Long after the names of those who first built Ember Ridge have been forgotten,
          our prayer is that the presence of God will remain.
        </PullQuote>

        <div class="prose-body mx-auto max-w-[42rem]">
          <p>
            If that becomes the legacy of Ember Ridge, every sacrifice made to build it
            will have been worthwhile.
          </p>
        </div>
      </Reveal>
    </div>
  </Section>

  <Section tone="cream" id="give" labelledby="give-heading">
    <div class="shell">
      <span id="ways-to-give" class="block scroll-mt-32"></span>
      <Reveal>
        <SectionHeading
          id="give-heading"
          eyebrow="Giving"
          title="Ways to give"
          lede="Gifts may be given through any of the methods below. Every gift designated for Ember Ridge is received and administered through Firebrand Revivalists and tracked to that purpose."
        />
      </Reveal>

      <div class="mt-14">
        <WaysToGive />
      </div>
    </div>
  </Section>

  <Section tone="stone" labelledby="next-heading">
    <div class="shell">
      <Reveal class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Next Step</p>
        <h2 id="next-heading" class="display-2 mt-4">Begin a conversation</h2>
        <div class="rule-gold mx-auto mt-6"></div>
        <p class="mt-7 text-[1.0625rem] leading-relaxed text-stone-700">
          Tell us how you believe God is inviting you to participate. A member of
          leadership will respond personally.
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="/contact" class="btn-primary w-full sm:w-auto">Contact leadership</a>
          <a href="/remodel-and-grounds#financial" class="btn-outline w-full sm:w-auto">Review the stewardship framework</a>
        </div>
      </Reveal>
    </div>
  </Section>
</BaseLayout>
