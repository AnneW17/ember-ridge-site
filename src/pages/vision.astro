---
// src/pages/vision.astro — The Vision
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import EmberMark from '../components/EmberMark.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Prose from '../components/Prose.astro';
import Card from '../components/Card.astro';
import Reveal from '../components/Reveal.astro';
import CTASection from '../components/CTASection.astro';

const multiplying = [
  { title: 'Healthy leaders', body: 'strengthen healthy families.' },
  { title: 'Healthy families', body: 'strengthen churches, organizations, and communities.' },
  { title: 'Those communities', body: 'can influence regions and nations.' },
];
---

<BaseLayout
  title="The Vision for Ember Ridge"
  description="The founding vision of Ember Ridge: a house prepared for those who carry unusual responsibility — received without performance, restored in the presence of God, and sent back with clarity and endurance."
>
  <PageHero
    eyebrow="The Founding Vision"
    title="The Fire That Still Remains"
    lede="A house prepared for the Lord — and, out of that devotion, a place where those who carry His work are restored and sent back strengthened."
  />

  <EmberMark immersive>
    An ember can appear small, buried, or nearly spent, yet it still holds living fire.
  </EmberMark>

  <Section tone="ivory" labelledby="first-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="first-heading"
          eyebrow="First, for the Lord"
          title="A house of worship before it is a house of restoration"
        />
      </Reveal>
      <Prose class="mt-12">
        <p>
          Ember Ridge exists for the Lord. Before it is a place of restoration, it is a
          house of worship.
        </p>
        <p>
          We believe God has called us to purchase and cultivate this land in Moravian
          Falls — to saturate it in worship and intercession, to tend the fire of His
          presence day and night, and to serve Him with everything we are.
        </p>
        <p>
          Out of that devotion everything else flows: refreshing, reformation, and
          restoration for leaders, prophets, pastors, intercessors, business leaders,
          and those carrying the weight of ministry.
        </p>
      </Prose>

      <div class="mt-16">
        <Prose>
          <p>
            Some places are built because an opportunity appears. Others are prepared
            because a generation has reached a moment of need.
          </p>
          <p>
            Those who carry unusual responsibility will be received here without
            performance, restored in His presence, and sent back into their callings with
            clarity and endurance.
          </p>
          <p>
            The name carries the assignment. Ember Ridge exists to tend what He has
            already ignited.
          </p>
        </Prose>
      </div>
    </div>
  </Section>

  <Section tone="stone">
    <div class="shell">
      <p data-reveal class="statement">
        We are not building a ministry for people. We are building a house for the Lord,
        and He is inviting people to come.
      </p>
    </div>
  </Section>

  <Section tone="linen" labelledby="multiplying-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="multiplying-heading"
          eyebrow="A Multiplying Vision"
          title="What God restores here is not meant to remain on the mountain"
          lede="This work is rooted in a multiplying vision."
        />
      </Reveal>

      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {multiplying.map((m, i) => (
          <Reveal delay={i * 100}>
            <Card title={m.title}>
              <p>{m.body}</p>
            </Card>
          </Reveal>
        ))}
      </div>

      <Reveal delay="120" class="mt-14 max-w-2xl">
        <p class="text-[1.0625rem] leading-relaxed text-stone-700">
          People will return to their homes and assignments carrying renewed love for
          Christ, greater spiritual maturity, healthier relationships, clearer
          discernment, and a deeper capacity to serve.
        </p>
        <p class="mt-7">
          <a href="/ministry-model" class="btn-quiet">How the ministry model works →</a>
        </p>
      </Reveal>
    </div>
  </Section>

  <CTASection
    title="Take this vision before the Lord"
    body="We ask those who encounter this vision to ask whether God is inviting them to pray, build, give, serve, or connect the ministry with others who carry a corresponding assignment."
  />
</BaseLayout>
