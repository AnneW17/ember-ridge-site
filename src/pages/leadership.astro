---
// src/pages/leadership.astro — Leadership and Accountability
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Prose from '../components/Prose.astro';
import LeadershipTeam from '../components/LeadershipTeam.astro';
import ReviewNote from '../components/ReviewNote.astro';
import Reveal from '../components/Reveal.astro';
import CTASection from '../components/CTASection.astro';
import { ministryStaff } from '../data/leadership';

const governance = [
  'Board-approved budgets',
  'Documented authority',
  'Conflict-of-interest standards',
  'Contracts for significant work',
  'Donor restrictions honored in accounting',
  'Appropriate insurance',
  'Background and safety policies',
  'Confidentiality requirements',
  'Professional review of acquisition, construction, and employment practices',
  'Licensed contractors and specialists where required',
];

---

<BaseLayout
  title="Leadership & Accountability"
  description="Ember Ridge is family-lived, professionally governed, and accountable. Meet the leadership team and review the governance standards of the ministry."
>
  <PageHero
    eyebrow="Leadership & Accountability"
    title="A Family Called to Steward, a Ministry Built to Endure"
    lede="Ember Ridge will be family-lived, professionally governed, and accountable."
  />

  <!-- Leadership Team -->
  <Section labelledby="team-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="team-heading"
          eyebrow="The Leadership Team"
          title="Those entrusted with the house"
          lede="Ember Ridge operates as a ministry expression of Firebrand Revivalists. Each leader below carries both a spiritual assignment and a defined professional responsibility."
        />
      </Reveal>

      <div class="mt-16">
        <LeadershipTeam />
      </div>

      <ReviewNote label="Needs review">
        Mark Burgett’s biography and portrait are placeholders awaiting his own text
        and a current photograph. Titles, credentials, and any professional or
        licensure references on this page should be confirmed before launch.
      </ReviewNote>
    </div>
  </Section>

  <!-- Ministry staff -->
  <Section tone="charcoal" labelledby="staff-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="staff-heading"
          eyebrow="Ministry Staff"
          title="Those who serve alongside"
        />
      </Reveal>

      <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:gap-10">
        {ministryStaff.map((person, i) => (
          <Reveal delay={i * 90}>
            <article class="group card card-lift flex h-full items-start gap-6">
              <div class="relative shrink-0">
                <img
                  src={person.image}
                  alt={person.alt}
                  width="900"
                  height="900"
                  loading="lazy"
                  decoding="async"
                  class="h-24 w-24 rounded-[0.25rem] object-cover object-top grayscale-[22%]
                         transition-all duration-700 [transition-timing-function:var(--ease-refined)]
                         group-hover:grayscale-0 sm:h-28 sm:w-28"
                />
                <div aria-hidden="true"
                     class="pointer-events-none absolute inset-0 rounded-[0.25rem] ring-1 ring-inset ring-gold-600/50
                            transition-all duration-700 group-hover:ring-gold-600/70"></div>
              </div>
              <div class="min-w-0 pt-1">
                <h3 class="font-display text-2xl leading-tight text-ink">{person.name}</h3>
                <p class="mt-2 font-sans text-[0.6875rem] uppercase tracking-[0.18em] text-gold-700">
                  {person.title}
                </p>
                {person.boardRole && (
                  <p class="mt-1.5 font-sans text-[0.6875rem] leading-relaxed text-stone-600">
                    {person.boardRole}
                  </p>
                )}
                <div class="brushed-gold mt-4 h-px w-12"></div>
              </div>
            </article>
          </Reveal>
        ))}
      </div>
    </div>
  </Section>

  <!-- Marketplace relationship -->
  <Section labelledby="sophion-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="sophion-heading"
          eyebrow="Related Entities"
          title="Clear lines between ministry and marketplace"
        />
      </Reveal>
      <div class="mt-12">
        <Prose>
          <p>
            The family’s marketplace work through Sophion Media &amp; Consulting Group
            complements this mission by strengthening leaders and organizations through
            advisory, legal-operations, strategy, media, and consulting services.
          </p>
          <p>
            Sophion’s work may support the larger vision through properly structured
            contributions and services. You can visit
            <a href="https://www.sophionhq.com" target="_blank" rel="noopener noreferrer" class="link-gold">www.sophionhq.com</a>
            to learn more<span class="sr-only"> (opens in a new tab)</span>.
          </p>
        </Prose>

        <ReviewNote label="Needs legal review">
          Related-party language, entity names, and any description of intercompany
          contributions or services should be reviewed by counsel and the ministry’s
          accountant, and should match the governing documents and conflict-of-interest
          policy.
        </ReviewNote>
      </div>
    </div>
  </Section>

  <!-- Governance -->
  <Section tone="charcoal" labelledby="governance-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="governance-heading"
          eyebrow="Governance"
          title="The spiritual nature of the assignment will never be used to avoid practical accountability"
        />
      </Reveal>

      <Reveal delay="100" class="mt-14 grid gap-x-10 gap-y-4 sm:grid-cols-2">
        {governance.map((item) => (
          <div class="flex items-start gap-4 border-l border-stone-200 py-1 pl-5">
            <span aria-hidden="true" class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-gold-500"></span>
            <p class="text-[0.9375rem] leading-relaxed text-ink">{item}</p>
          </div>
        ))}
      </Reveal>
    </div>
  </Section>

  <CTASection
    title="Serve as an advisor"
    body="Some will bring professional wisdom in architecture, engineering, construction, finance, law, hospitality, security, technology, landscaping, or organizational development. If that is you, we would welcome the conversation."
    primary={{ label: 'Offer your expertise', href: '/partner#advise' }}
    secondary={{ label: 'Contact leadership', href: '/contact' }}
  />
</BaseLayout>
