---
// src/pages/leadership.astro — Leadership and Accountability
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import LeadershipTeam from '../components/LeadershipTeam.astro';
import Reveal from '../components/Reveal.astro';
import CTASection from '../components/CTASection.astro';
import { ministryStaff } from '../data/leadership';

const governance = [
  'Board-approved budgets',
  'Documented authority',
  'Conflict-of-interest standards',
  'Contracts for significant work',
  'Donor restrictions honored in accounting',
  'Appropriate insurance',
  'Background and safety policies',
  'Confidentiality requirements',
  'Professional review of acquisition, construction, and employment practices',
  'Licensed contractors and specialists where required',
];

---

<BaseLayout
  title="Leadership & Accountability"
  description="Ember Ridge is family-lived, professionally governed, and accountable. Meet the leadership team and review the governance standards of the ministry."
>
  <PageHero
    eyebrow="Leadership & Accountability"
    title="A Family Called to Steward, a Ministry Built to Endure"
    lede="Ember Ridge will be family-lived, professionally governed, and accountable."
  />

  <!-- Leadership Team -->
  <Section tone="ivory" labelledby="team-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="team-heading"
          eyebrow="The Leadership Team"
          title="Those entrusted with the house"
          lede="Ember Ridge is an auxiliary ministry of Firebrand Revivalists&#8482;. Each leader below carries both a spiritual assignment and a defined professional responsibility."
        />
      </Reveal>

      <Reveal class="mt-14">
        <h3 id="ministry-team-heading" class="eyebrow">Ministry Leadership Team</h3>
        <div class="brushed-gold mt-4 h-px w-14"></div>
      </Reveal>

      <div class="mt-10">
        <LeadershipTeam headingLevel={4} />
      </div>


      <div class="mt-8">
        <LeadershipTeam people={ministryStaff} headingLevel={4} idPrefix="staff-bio" />
      </div>
    </div>
  </Section>

  <!-- Governance -->
  <Section id="governance" tone="cream" labelledby="governance-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="governance-heading"
          eyebrow="Governance"
          title="The spiritual nature of the assignment will never be used to avoid practical accountability"
        />
      </Reveal>

      <Reveal delay="100" class="mt-14 grid gap-x-10 gap-y-4 sm:grid-cols-2">
        {governance.map((item) => (
          <div class="flex items-start gap-4 border-l border-stone-200 py-1 pl-5">
            <span aria-hidden="true" class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-gold-500"></span>
            <p class="text-[0.9375rem] leading-relaxed text-ink">{item}</p>
          </div>
        ))}
      </Reveal>
    </div>
  </Section>

  <CTASection
    title="Partner with this work"
    body="Governance depends on people willing to lend real expertise. If you carry professional skill that could serve this work, we would welcome the conversation."
    primary={{ label: 'Ways to partner', href: '/partner#partner' }}
    secondary={{ label: 'Contact leadership', href: '/contact' }}
  />
</BaseLayout>
