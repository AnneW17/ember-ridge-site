---
// src/pages/leadership.astro — Leadership and Accountability
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Prose from '../components/Prose.astro';
import LeadershipTeam from '../components/LeadershipTeam.astro';
import Card from '../components/Card.astro';
import Callout from '../components/Callout.astro';
import ReviewNote from '../components/ReviewNote.astro';
import Reveal from '../components/Reveal.astro';
import CTASection from '../components/CTASection.astro';
import { widerTeam } from '../data/leadership';

const governance = [
  'Board-approved budgets',
  'Documented authority',
  'Conflict-of-interest standards',
  'Contracts for significant work',
  'Donor restrictions honored in accounting',
  'Appropriate insurance',
  'Background and safety policies',
  'Confidentiality requirements',
  'Professional review of acquisition, construction, and employment practices',
  'Licensed contractors and specialists where required',
];

const endurance = [
  { title: 'Leadership development', body: 'Raising and releasing those who will carry the work forward.' },
  { title: 'Written policies', body: 'Clear standards that outlast the people who wrote them.' },
  { title: 'Succession planning', body: 'Structure capable of remaining faithful after the founding generation.' },
  { title: 'Financial reserves', body: 'Preventive maintenance and reserves rather than crisis funding.' },
];
---

<BaseLayout
  title="Leadership & Accountability"
  description="Ember Ridge is family-lived, professionally governed, and accountable beyond the personalities who first carry the vision. Meet the leadership team and review the governance standards of the ministry."
>
  <PageHero
    eyebrow="Leadership & Accountability"
    title="A Family Called to Steward, a Ministry Built to Endure"
    lede="Ember Ridge will be family-lived, professionally governed, and accountable beyond the personalities who first carry the vision."
  />

  <!-- Leadership Team -->
  <Section labelledby="team-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="team-heading"
          eyebrow="The Leadership Team"
          title="Those entrusted with the house"
          lede="Ember Ridge operates as a ministry expression of Firebrand Revivalists. Each leader below carries both a spiritual assignment and a defined professional responsibility."
        />
      </Reveal>

      <div class="mt-16">
        <LeadershipTeam />
      </div>

      <ReviewNote label="Needs review">
        Mark Burgett’s biography and portrait are placeholders awaiting his own text
        and a current photograph. Titles, credentials, and any professional or
        licensure references on this page should be confirmed before launch.
      </ReviewNote>
    </div>
  </Section>

  <!-- Wider ministry -->
  <Section tone="charcoal" labelledby="wider-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="wider-heading"
          eyebrow="The Wider Ministry"
          title="Additional discernment and professional expertise"
        />
      </Reveal>

      <div class="mt-14 grid gap-6 sm:grid-cols-2">
        {widerTeam.map((person, i) => (
          <Reveal delay={i * 90}>
            <Card title={person.name}>
              <p class="font-sans text-[0.6875rem] uppercase tracking-[0.16em] text-gold-500">
                {person.title}
              </p>
              <p class="mt-4">{person.note}</p>
            </Card>
          </Reveal>
        ))}
      </div>

      <div class="mt-14">
        <Prose>
          <p>
            Formal board oversight extends accountability beyond the immediate family
            and brings additional discernment, professional expertise, and fiduciary
            responsibility to the work.
          </p>
        </Prose>
      </div>
    </div>
  </Section>

  <!-- Marketplace relationship -->
  <Section labelledby="sophion-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="sophion-heading"
          eyebrow="Related Entities"
          title="Clear lines between ministry and marketplace"
        />
      </Reveal>
      <div class="mt-12">
        <Prose>
          <p>
            The family’s marketplace work through Sophion Media &amp; Consulting Group
            complements this mission by strengthening leaders and organizations through
            advisory, legal-operations, strategy, media, and consulting services.
          </p>
          <p>
            Sophion is not a substitute for the nonprofit ministry, and financial
            relationships between the entities must remain appropriately documented and
            transparent. Its work may support the larger vision through properly
            structured contributions, services, or shared initiatives reviewed by legal
            and financial professionals.
          </p>
        </Prose>

        <ReviewNote label="Needs legal review">
          Related-party language, entity names, and any description of intercompany
          contributions or services should be reviewed by counsel and the ministry’s
          accountant, and should match the governing documents and conflict-of-interest
          policy.
        </ReviewNote>
      </div>
    </div>
  </Section>

  <!-- Governance -->
  <Section tone="charcoal" labelledby="governance-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="governance-heading"
          eyebrow="Governance"
          title="The spiritual nature of the assignment will never be used to avoid practical accountability"
        />
      </Reveal>

      <Reveal delay="100" class="mt-14 grid gap-x-10 gap-y-4 sm:grid-cols-2">
        {governance.map((item) => (
          <div class="flex items-start gap-4 border-l border-charcoal-300 py-1 pl-5">
            <span aria-hidden="true" class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-gold-500"></span>
            <p class="text-[0.9375rem] leading-relaxed text-stone-100">{item}</p>
          </div>
        ))}
      </Reveal>
    </div>
  </Section>

  <!-- Endurance -->
  <Section labelledby="endurance-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="endurance-heading"
          eyebrow="Built to Endure"
          title="Not a personality-centered ministry"
          lede="The long-term goal is to establish a culture and structure capable of remaining faithful after the founding generation."
        />
      </Reveal>

      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {endurance.map((item, i) => (
          <Reveal delay={i * 80}>
            <Card title={item.title}>
              <p>{item.body}</p>
            </Card>
          </Reveal>
        ))}
      </div>

      <Callout>
        <p>
          Clear theological and operational standards will help protect the vision for
          those who come after us.
        </p>
      </Callout>
    </div>
  </Section>

  <CTASection
    title="Serve as an advisor"
    body="Some will bring professional wisdom in architecture, engineering, construction, finance, law, hospitality, security, technology, landscaping, or organizational development. If that is you, we would welcome the conversation."
    primary={{ label: 'Offer your expertise', href: '/partner#advise' }}
    secondary={{ label: 'Contact leadership', href: '/contact' }}
  />
</BaseLayout>
