---
// src/pages/our-ministries.astro — Firebrand Revivalists & the family of ministries
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Reveal from '../components/Reveal.astro';
import CTASection from '../components/CTASection.astro';
---

<BaseLayout
  title="Ministries & Marketplace"
  description="Firebrand Revivalists and the family of ministries it carries — Ember Ridge, Jesus Loves the Little Children, and Generational Legacy Foundation — alongside the family's related marketplace enterprise, Sophion Media & Consulting Group."
>
  <PageHero
    eyebrow="Firebrand Revivalists"
    title="One Family, Many Assignments"
    lede="Ember Ridge is one expression of a wider work God is building. Here is the rest of it — each ministry carrying its own calling, under the same covering."
  />

  <!-- Firebrand Revivalists — the parent ministry -->
  <Section tone="ink" size="sm" labelledby="firebrand-heading">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="glow-gold-soft animate-breathe absolute left-1/2 top-0 h-[24rem] w-[24rem]
                  max-w-[110vw] -translate-x-1/2 -translate-y-1/3 rounded-full blur-[90px] opacity-40
                  [will-change:opacity,transform]"></div>
    </div>
    <div class="shell relative">
      <Reveal class="mx-auto flex max-w-2xl flex-col items-center text-center">
        <img
          src="/images/firebrand-logo-mark.png"
          alt="Firebrand Revivalists — Igniting Hearts. Awakening Destiny. Reviving Glory."
          width="640"
          height="640"
          loading="eager"
          decoding="async"
          class="h-40 w-40 shadow-[0_0_0_1px_rgb(200_162_74_/_0.25)] sm:h-48 sm:w-48"
        />
        <h2 id="firebrand-heading" class="sr-only">Firebrand Revivalists — The Parent Ministry</h2>
        <p class="mt-8 max-w-xl text-[1.0625rem] leading-relaxed" style="color:var(--color-cream-dark);">
          Firebrand Revivalists is the ministry that oversees this work, and
          every ministry entrusted to it.
        </p>
        <p class="mt-7">
          <a
            href="https://www.firebrandrevivalists.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-gold !px-7 !py-3.5 !text-[0.6875rem]"
          >
            Visit Website
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="ml-1.5">
              <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="sr-only">firebrandrevivalists.com (opens in a new tab)</span>
          </a>
        </p>
      </Reveal>
    </div>
  </Section>

  <!-- Sibling ministries, each in its own brand -->
  <Section tone="cream" size="sm" labelledby="ministries-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="ministries-heading"
          eyebrow="Ministries Under Firebrand"
          title="Each carrying its own calling"
          align="center"
        />
      </Reveal>

      <div class="mt-12 grid gap-8 lg:grid-cols-2">
        <!-- Jesus Loves the Little Children -->
        <Reveal delay={100}>
          <div class="jllc relative flex h-full flex-col items-center overflow-hidden p-10 text-center shadow-[var(--shadow-lift-lg)] sm:p-12">
            <span aria-hidden="true"
                  class="absolute inset-x-0 top-0 h-px"
                  style="background-image:linear-gradient(to right,transparent,rgb(169 189 236 / 0.6),transparent);"></span>
            <div class="flex h-28 w-32 shrink-0 items-center justify-center bg-white p-4
                        shadow-[var(--shadow-lift)] sm:h-32 sm:w-36">
              <img
                src="/images/jllc-logo.jpg"
                alt="Jesus Loves the Little Children"
                width="200"
                height="200"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-contain"
              />
            </div>
            <p class="eyebrow mt-8">Auxiliary Ministry of Firebrand Revivalists</p>
            <h3 class="mt-3 font-display text-2xl">Jesus Loves the Little Children</h3>
            <p class="mt-5 flex-1 text-[0.9375rem] leading-relaxed">
              Trained chaplains serving directly in schools — ministering to
              children, families, and staff through prayer, encouragement,
              and biblical guidance.
            </p>
            <p class="mt-8">
              <a
                href="https://www.firebrandrevivalists.com/jllc"
                target="_blank"
                rel="noopener noreferrer"
                class="btn border text-[0.6875rem]"
                style="border-color:#a9bdec;color:#d3ddf7;"
              >
                Visit Website
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="ml-1.5">
                  <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="sr-only">firebrandrevivalists.com/jllc (opens in a new tab)</span>
              </a>
            </p>
          </div>
        </Reveal>

        <!-- Generational Legacy Foundation -->
        <Reveal delay={200}>
          <div class="gen-legacy relative flex h-full flex-col items-center overflow-hidden p-10 text-center shadow-[var(--shadow-lift-lg)] sm:p-12">
            <span aria-hidden="true"
                  class="absolute inset-x-0 top-0 h-px"
                  style="background-image:linear-gradient(to right,transparent,rgb(217 104 63 / 0.55),transparent);"></span>
            <div class="flex h-28 w-32 shrink-0 items-center justify-center bg-white p-4
                        shadow-[var(--shadow-lift)] sm:h-32 sm:w-36">
              <img
                src="/images/generational-legacy-logo.png"
                alt="Generational Legacy Foundation"
                width="200"
                height="200"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-contain"
              />
            </div>
            <p class="eyebrow mt-8">Auxiliary Ministry of Firebrand Revivalists</p>
            <h3 class="mt-3 font-display text-2xl">Generational Legacy Foundation</h3>
            <p class="mt-5 flex-1 text-[0.9375rem] leading-relaxed">
              A philanthropic ministry of Firebrand Revivalists, giving
              practical expression to generosity and stewardship across
              generations.
            </p>
            <p class="mt-8">
              <a
                href="https://thegenerationallegacy.org"
                target="_blank"
                rel="noopener noreferrer"
                class="btn border text-[0.6875rem]"
                style="border-color:#d9683f;color:#b8502c;"
              >
                Visit Website
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="ml-1.5">
                  <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="sr-only">thegenerationallegacy.org (opens in a new tab)</span>
              </a>
            </p>
          </div>
        </Reveal>
      </div>
    </div>
  </Section>

  <!-- Serving in the Marketplace -->
  <Section tone="linen" size="sm" labelledby="sophion-heading">
    <div class="shell">
      <Reveal>
        <p class="eyebrow text-center">A Related Enterprise</p>
        <p class="lede mx-auto mt-4 max-w-2xl text-center">
          Sophion Media &amp; Consulting Group is a separate, for-profit
          company.
        </p>
      </Reveal>

      <Reveal delay={100} class="mt-14">
        <div class="sophion relative overflow-hidden p-10 shadow-[var(--shadow-lift-lg)] sm:p-14">
          <span aria-hidden="true"
                class="absolute inset-x-0 top-0 h-px"
                style="background-image:linear-gradient(to right,transparent,rgb(200 162 74 / 0.7),transparent);"></span>

          <div class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-14">
            <div class="lg:col-span-7">
              <p class="eyebrow">Serving in the Marketplace</p>
              <h2 id="sophion-heading" class="display-3 mt-4">
                Sophion Media and Consulting Group
              </h2>
              <div class="mt-6 h-px w-16"
                   style="background-image:linear-gradient(to right,var(--sophion-gold),transparent);"></div>

              <div class="mt-7 space-y-5 text-[1.0625rem] leading-relaxed" style="color:#c9d6d8;">
                <p>
                  The family’s marketplace work through Sophion Media &amp; Consulting
                  Group complements this mission by strengthening leaders and
                  organizations through advisory, legal-operations, strategy, media, and
                  consulting services.
                </p>
                <p>
                  Sophion’s work may support the larger vision through properly structured
                  contributions and services.
                </p>
              </div>

              <p class="mt-9">
                <a
                  href="https://www.sophionhq.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn border text-[0.75rem]"
                  style="border-color:var(--sophion-gold);color:var(--sophion-gold);"
                >
                  Visit sophionhq.com
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="ml-1">
                    <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2"
                          stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              </p>
            </div>

            <div class="lg:col-span-5">
              <div class="flex items-center justify-center">
                <img
                  src="/images/sophion-logo.png"
                  alt="Sophion Media &amp; Consulting Group"
                  width="287"
                  height="345"
                  loading="lazy"
                  decoding="async"
                  class="h-48 w-auto sm:h-56 lg:h-64"
                />
              </div>
            </div>
          </div>
        </div>
      </Reveal>
    </div>
  </Section>

  <CTASection
    eyebrow="Explore Further"
    title="See the whole work"
    body="Firebrand Revivalists and this family of ministries share one calling, carried out in different assignments. Read the vision behind Ember Ridge, or meet the leadership that stewards all of it."
    primary={{ label: 'Read the Vision', href: '/vision' }}
    secondary={{ label: 'Meet the Leadership', href: '/leadership' }}
  />
</BaseLayout>
