---
// src/pages/remodel-and-grounds.astro — Remodel, Grounds & Financial Stewardship
// Route deliberately unchanged so existing links keep working.
// Merged from the former Campus Vision page. Covers the lodge, the renovation,
// the cabins, and the outdoor spaces.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Prose from '../components/Prose.astro';
import Card from '../components/Card.astro';
import ReviewNote from '../components/ReviewNote.astro';
import Reveal from '../components/Reveal.astro';
import CTASection from '../components/CTASection.astro';

const inside = [
  {
    numeral: '01',
    title: 'The Great Room',
    body: 'The stone fireplace and vaulted ceiling stay. Flexible seating lets the room move between worship, teaching, prayer, and ordinary conversation.',
  },
  {
    numeral: '02',
    title: 'Long-Table Dining & Kitchen',
    body: 'Long tables, because shared meals are not secondary here. The kitchen is renovated to serve both daily household use and larger hospitality.',
  },
  {
    numeral: '03',
    title: 'Guest Rooms & Prayer Rooms',
    body: 'Bedrooms refreshed for comfort, privacy, and durability. Dedicated quiet rooms so personal prayer can continue alongside the life of the house.',
  },
  {
    numeral: '04',
    title: 'The Lower Level',
    body: 'Built out after inspection and code review to hold prayer, teaching, operations, and storage without crowding the household spaces above.',
  },
];

const concepts = [
  {
    src: '/images/campus/prayer-garden.jpg',
    alt: 'Concept reference: prayer garden with walking paths, contemplative seating and Scripture markers',
    caption: 'Prayer garden — paths, seating and Scripture markers (concept)',
  },
  {
    src: '/images/campus/pavilion-elevation.jpg',
    alt: 'Concept reference: worship pavilion seen from the front, timber trusses over open seating',
    caption: 'Worship pavilion — exterior view (concept)',
  },
  {
    src: '/images/campus/pavilion-concept-drawing.jpg',
    alt: 'Concept drawing: worship pavilion, approximately forty by sixty feet, with seasonal enclosure panels and curved pews',
    caption: 'Worship pavilion — approx. 40 × 60 ft (concept drawing)',
  },
  {
    src: '/images/campus/pavilion-in-landscape.jpg',
    alt: 'Concept reference: worship pavilion set in open pasture with the lodge beyond',
    caption: 'Worship pavilion — set within the property (concept)',
  },
];

const outside = [
  {
    numeral: '05',
    title: 'The Covered Porch',
    body: 'Generous and weather-protected, extending the usable life of the property through the mountain seasons. Room for reading, meals, and counsel.',
  },
  {
    numeral: '06',
    title: 'The Prayer Garden',
    body: 'Walking paths, contemplative seating, Scripture markers, and intentional plantings — an outdoor extension of the house of prayer.',
  },
  {
    numeral: '07',
    title: 'Prayer Trails & Fire Circle',
    body: 'Trails for walking the land in prayer, and a gathering fire circle for testimony and conversation after dark. Working spaces, not attractions.',
  },
  {
    numeral: '08',
    title: 'The Worship Pavilion',
    body: 'A covered, open-air structure of roughly forty by sixty feet in timber and stone, for worship, teaching, and regional gatherings.',
  },
];
---

<BaseLayout
  title="Remodel, Grounds & Financial Stewardship"
  description="The plan for the Ember Ridge lodge and land: what the renovation includes, the three cabins for personal retreat, and the grounds that carry the devotional life of the house."
>
  <PageHero
    eyebrow="Remodel, Grounds &amp; Financial Stewardship"
    title="A Place Designed to Serve the Mission"
    lede="Every renovation and building is measured against one question: does it help people minister to the Lord, live in healthy community, and be restored for faithful service?"
  />

  <Section tone="ivory" class="!py-14 sm:!py-16 lg:!py-20" size="sm">
    <div class="shell">
      <Reveal>
        <div class="callout">
          <p class="text-[1.0625rem] leading-relaxed text-stone-700">
            <strong class="font-semibold text-ink">Concept only.</strong> The image and
            descriptions on this page show design direction for a planned renovation and
            expansion. They do not show the property in its current condition, and the
            property has not yet been purchased.
          </p>
        </div>
      </Reveal>
    </div>
  </Section>

  <!-- The lodge -->
  <Section tone="linen" class="!py-14 sm:!py-16 lg:!py-20" labelledby="lodge-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading id="lodge-heading" eyebrow="The Lodge" title="What we are starting with" />
      </Reveal>
      <div class="mt-12">
        <Prose>
          <p>
            The lodge was built in 1993 and holds roughly ten bedrooms and eleven
            bathrooms on about eleven acres. Vaulted gathering rooms, a stone fireplace,
            and real guest capacity give the vision a strong foundation.
          </p>
          <p>
            Before any work begins, the property goes through full professional
            inspection — structure, roof, HVAC, plumbing, electrical, water and septic,
            fire and life safety, accessibility, drainage, and code.
          </p>
          <p>
            The renovation keeps what makes the lodge welcoming and gives it a durable,
            high-end mountain character: natural wood, a black roof, stone, leather,
            natural textiles, restrained lighting. Refined rather than rustic.
          </p>
        </Prose>
      </div>

      <Reveal delay={120} class="mt-10">
        <figure>
          <div class="overflow-hidden border border-stone-200 bg-cream shadow-[var(--shadow-lift-lg)]">
            <img
              src="/images/campus/lodge-concept.jpg"
              alt="Restoration concept for the Ember Ridge lodge — timber and stone with a covered wraparound porch"
              width="1836"
              height="857"
              loading="lazy"
              decoding="async"
              class="w-full object-cover"
            />
          </div>
          <figcaption class="mt-4 flex items-start gap-3 text-xs leading-relaxed text-stone-600">
            <span aria-hidden="true" class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-gold-600"></span>
            Restoration concept — design direction for the renovated lodge. Concept
            only; not the property in its current condition.
          </figcaption>
        </figure>
      </Reveal>
    </div>
  </Section>

  <!-- Inside -->
  <Section tone="cream" class="!py-14 sm:!py-16 lg:!py-20" labelledby="inside-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading id="inside-heading" eyebrow="Inside the Lodge" title="Rooms shaped around shared life" />
      </Reveal>
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {inside.map((el, i) => (
          <Reveal delay={(i % 2) * 90}>
            <Card numeral={el.numeral} title={el.title}><p>{el.body}</p></Card>
          </Reveal>
        ))}
      </div>
    </div>
  </Section>

  <!-- Three cabins -->
  <Section tone="stone" class="!py-14 sm:!py-16 lg:!py-20" labelledby="cabins-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="cabins-heading"
          eyebrow="Guest Housing"
          title="Three Cabins for Restoration and Refueling"
          lede="Alongside the main lodge, the property will hold three cabins — quiet, welcoming spaces set apart for personal retreat."
        />
      </Reveal>

      <div class="mt-10">
        <div class="max-w-[46rem]">
          <Reveal class="prose-body">
            <p>
              Each cabin is intended for rest, prayer, and refueling — somewhere a person
              can step away from the demands of life and ministry without stepping into
              another schedule.
            </p>
            <p>
              They are designed as places of encounter. Leaders, prophets, pastors,
              intercessors, business leaders, and families can come apart for a season, be
              quiet before the Lord, and be refreshed in His presence before returning to
              the work He has given them.
            </p>
          </Reveal>
        </div>
      </div>
    </div>
  </Section>

  <!-- Grounds -->
  <Section tone="ivory" class="!py-14 sm:!py-16 lg:!py-20" labelledby="outside-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading id="outside-heading" eyebrow="The Grounds" title="The devotional life of the house, outdoors" />
      </Reveal>
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {outside.map((el, i) => (
          <Reveal delay={(i % 2) * 90}>
            <Card numeral={el.numeral} title={el.title}><p>{el.body}</p></Card>
          </Reveal>
        ))}
      </div>

      <Reveal delay={120} class="mt-14">
        <h3 class="font-sans text-xs font-semibold uppercase tracking-[0.16em] text-gold-700">
          Concept references
        </h3>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {concepts.map((fig) => (
            <figure class="group flex flex-col">
              <div class="overflow-hidden border border-stone-200 bg-cream shadow-[var(--shadow-lift)]
                          transition-all duration-500 group-hover:shadow-[var(--shadow-lift-lg)]">
                <img
                  src={fig.src}
                  alt={fig.alt}
                  width="640"
                  height="427"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[3/2] w-full object-cover transition-transform duration-[1200ms]
                         [transition-timing-function:var(--ease-refined)] group-hover:scale-[1.03]"
                />
              </div>
              <figcaption class="mt-3 text-xs leading-relaxed text-stone-600">{fig.caption}</figcaption>
            </figure>
          ))}
        </div>
      </Reveal>

      <ReviewNote label="Planning concept">
        Final size, placement, acoustics, utilities, accessibility, and weather protection
        for all new structures are determined through survey, engineering, zoning, and
        final architectural design. Dimensions given here are preliminary.
      </ReviewNote>
    </div>
  </Section>


  <CTASection
    title="Help us build it well"
    body="A house like this is built in prayer long before it is built in timber and stone. If this stirs something in you, take it to the Lord and ask what part He would have you carry."
    primary={{ label: 'Partner With Us', href: '/partner' }}
    secondary={{ label: 'Pray With Us', href: '/house-of-prayer#intercession' }}
  />
</BaseLayout>
