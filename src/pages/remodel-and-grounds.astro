---
// src/pages/remodel-and-grounds.astro — Remodel, Grounds & Financial Stewardship
//
// One page in three movements: what is being renovated, what is being made of
// the land, and what it costs and how it is funded. The financial content was
// merged here from the retired /financial-stewardship route (301 in netlify.toml).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PartMarker from '../components/PartMarker.astro';
import Prose from '../components/Prose.astro';
import Card from '../components/Card.astro';
import Callout from '../components/Callout.astro';
import CapitalTable from '../components/CapitalTable.astro';
import PullQuote from '../components/PullQuote.astro';
import ReviewNote from '../components/ReviewNote.astro';
import Reveal from '../components/Reveal.astro';
import CTASection from '../components/CTASection.astro';

const contents = [
  { label: 'The Remodel', href: '#remodel' },
  { label: 'The Grounds', href: '#grounds' },
  { label: 'Financial Stewardship', href: '#financial' },
];

const funding = [
  'Major gifts',
  'Recurring partners',
  'Foundation or ministry grants',
  'Donated professional services',
  'Building materials and furnishings',
  'Equipment',
  'Legacy gifts',
];

const operating = [
  'Property insurance and utilities',
  'Maintenance and preventive care',
  'Hospitality and guest provision',
  'Staff and compensated intercessors',
  'Ministry supplies and technology',
  'Security and professional services',
  'Transportation',
  'An operating reserve',
];

const concepts = [
  {
    src: '/images/campus/prayer-garden.jpg',
    alt: 'Concept reference: prayer garden with walking paths, contemplative seating and Scripture markers',
    caption: 'Prayer garden — paths, seating and Scripture markers',
  },
  {
    src: '/images/campus/pavilion-elevation.jpg',
    alt: 'Concept reference: worship pavilion seen from the front, timber trusses over open seating',
    caption: 'Worship pavilion — exterior view',
  },
  {
    src: '/images/campus/pavilion-concept-drawing.jpg',
    alt: 'Concept drawing: worship pavilion, approximately forty by sixty feet, with seasonal enclosure panels and curved pews',
    caption: 'Worship pavilion — approximately 40 × 60 ft',
  },
  {
    src: '/images/campus/pavilion-in-landscape.jpg',
    alt: 'Concept reference: worship pavilion set in open pasture with the lodge beyond',
    caption: 'Worship pavilion — set within the property',
  },
];

const inside = [
  {
    numeral: '01',
    title: 'The Great Room',
    body: 'The stone fireplace and vaulted ceiling stay. Flexible seating lets the room move between worship, teaching, prayer, and ordinary conversation.',
  },
  {
    numeral: '02',
    title: 'Long-Table Dining & Kitchen',
    body: 'Long tables, because shared meals are not secondary here. The kitchen is renovated to serve both daily household use and larger hospitality.',
  },
  {
    numeral: '03',
    title: 'Guest Rooms & Prayer Rooms',
    body: 'Bedrooms refreshed for comfort, privacy, and durability. Dedicated quiet rooms so personal prayer can continue alongside the life of the house.',
  },
  {
    numeral: '04',
    title: 'The Lower Level',
    body: 'Built out after inspection and code review to hold prayer, teaching, operations, and storage without crowding the household spaces above.',
  },
];

const outside = [
  {
    numeral: '05',
    title: 'The Covered Porch',
    body: 'Generous and weather-protected, extending the usable life of the property through the mountain seasons. Room for reading, meals, and counsel.',
  },
  {
    numeral: '06',
    title: 'The Prayer Garden',
    body: 'Walking paths, contemplative seating, Scripture markers, and intentional plantings — an outdoor extension of the house of prayer.',
  },
  {
    numeral: '07',
    title: 'Prayer Trails & Fire Circle',
    body: 'Trails for walking the land in prayer, and a gathering fire circle for testimony and conversation after dark. Working spaces, not attractions.',
  },
  {
    numeral: '08',
    title: 'The Worship Pavilion',
    body: 'A covered, open-air structure of roughly forty by sixty feet in timber and stone, for worship, teaching, and regional gatherings.',
  },
];
---

<BaseLayout
  title="Remodel, Grounds & Financial Stewardship"
  description="The plan for the Ember Ridge lodge and land: what the renovation includes, the cabins and grounds, and the capital ranges, operating budget and giving that will fund it."
>
  <PageHero
    eyebrow="Remodel, Grounds &amp; Financial Stewardship"
    title="A Place Designed to Serve the Mission"
    lede="What is being renovated, what is being made of the land, and what it will take to build it — set out in full."
  />

  <!-- Contents -->
  <Section tone="ivory" size="sm" class="!py-8">
    <div class="shell">
      <nav aria-label="On this page">
        <ul class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 sm:gap-x-5">
          {contents.map((c, i) => (
            <li class="flex items-center gap-3 sm:gap-5">
              {i > 0 && <span aria-hidden="true" class="h-1 w-1 rounded-full bg-gold-600/60"></span>}
              <a
                href={c.href}
                class="font-sans text-[0.6875rem] uppercase tracking-[0.18em] text-stone-600
                       transition-colors duration-300 hover:text-gold-700"
              >
                {c.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </Section>

  <!-- Concept disclaimer -->
  <Section tone="ivory" size="sm" class="!py-10">
    <div class="shell">
      <Reveal>
        <div class="callout">
          <p class="text-[1.0625rem] leading-relaxed text-stone-700">
            <strong class="font-semibold text-ink">Concept only.</strong> Every image on
            this page shows design direction, not the property as it stands today. The
            property has not yet been purchased.
          </p>
        </div>
      </Reveal>
    </div>
  </Section>

  <!-- ══ PART ONE ══ -->
  <Section tone="linen" size="sm" class="!py-14 sm:!py-16">
    <div class="shell">
      <Reveal>
        <PartMarker
          part="Part One"
          id="remodel"
          title="The Remodel"
          lede="A lodge built in 1993, renovated for the work it is being given."
        />
      </Reveal>
    </div>
  </Section>

  <!-- The lodge -->
  <Section tone="ivory" class="!py-14 sm:!py-16 lg:!py-20" labelledby="lodge-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading id="lodge-heading" eyebrow="The Lodge" title="What we are starting with" />
      </Reveal>
      <div class="mt-12">
        <Prose>
          <p>
            The lodge was built in 1993 and holds roughly ten bedrooms and eleven
            bathrooms on about eleven acres. Vaulted gathering rooms, a stone fireplace,
            and real guest capacity give the vision a strong foundation.
          </p>
          <p>
            Before any work begins, the property goes through full professional
            inspection — structure, roof, HVAC, plumbing, electrical, water and septic,
            fire and life safety, accessibility, drainage, and code.
          </p>
          <p>
            The renovation keeps what makes the lodge welcoming and gives it a durable,
            high-end mountain character: natural wood, a black roof, stone, leather,
            natural textiles, restrained lighting. Refined rather than rustic.
          </p>
        </Prose>
      </div>

      <Reveal delay={120} class="mt-10">
        <figure>
          <div class="overflow-hidden border border-stone-200 bg-cream shadow-[var(--shadow-lift-lg)]">
            <img
              src="/images/campus/lodge-concept.jpg"
              alt="Restoration concept for the Ember Ridge lodge — timber and stone with a covered wraparound porch"
              width="1836"
              height="857"
              loading="lazy"
              decoding="async"
              class="w-full object-cover"
            />
          </div>
          <figcaption class="mt-4 flex items-start gap-3 text-xs leading-relaxed text-stone-600">
            <span aria-hidden="true" class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-gold-600"></span>
Restoration concept — design direction for the renovated lodge.
          </figcaption>
        </figure>
      </Reveal>
    </div>
  </Section>

  <!-- Inside -->
  <Section tone="linen" class="!py-14 sm:!py-16 lg:!py-20" labelledby="inside-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading id="inside-heading" eyebrow="Inside the Lodge" title="Rooms shaped around shared life" />
      </Reveal>
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {inside.map((el, i) => (
          <Reveal delay={(i % 2) * 90}>
            <Card numeral={el.numeral} title={el.title}><p>{el.body}</p></Card>
          </Reveal>
        ))}
      </div>
    </div>
  </Section>

  <!-- Three cabins -->
  <Section tone="cream" class="!py-14 sm:!py-16 lg:!py-20" labelledby="cabins-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="cabins-heading"
          eyebrow="Guest Housing"
          title="Three Cabins for Restoration and Refueling"
          lede="Alongside the main lodge, the property will hold three cabins — quiet, welcoming spaces set apart for personal retreat."
        />
      </Reveal>

      <div class="mt-10">
        <div class="max-w-[46rem]">
          <Reveal class="prose-body">
            <p>
              Each cabin is intended for rest, prayer, and refueling — somewhere a person
              can step away from the demands of life and ministry without stepping into
              another schedule.
            </p>
            <p>
              They are designed as places of encounter. Leaders, prophets, pastors,
              intercessors, business leaders, and families can come apart for a season, be
              quiet before the Lord, and be refreshed in His presence before returning to
              the work He has given them.
            </p>
          </Reveal>
        </div>
      </div>
    </div>
  </Section>

  <!-- ══ PART TWO ══ -->
  <Section tone="cream" size="sm" class="!py-14 sm:!py-16">
    <div class="shell">
      <Reveal>
        <PartMarker
          part="Part Two"
          id="grounds"
          title="The Grounds"
          lede="The devotional life of the house carried outdoors, and what the land is being prepared to hold."
        />
      </Reveal>
    </div>
  </Section>

  <!-- Grounds -->
  <Section tone="linen" class="!py-14 sm:!py-16 lg:!py-20" labelledby="outside-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading id="outside-heading" eyebrow="The Grounds" title="The devotional life of the house, outdoors" />
      </Reveal>
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {outside.map((el, i) => (
          <Reveal delay={(i % 2) * 90}>
            <Card numeral={el.numeral} title={el.title}><p>{el.body}</p></Card>
          </Reveal>
        ))}
      </div>

      <Reveal delay={120} class="mt-14">
        <h3 class="font-sans text-xs font-semibold uppercase tracking-[0.16em] text-gold-700">
          Concept references
        </h3>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {concepts.map((fig) => (
            <figure class="group flex flex-col">
              <div class="overflow-hidden border border-stone-200 bg-cream shadow-[var(--shadow-lift)]
                          transition-all duration-500 group-hover:shadow-[var(--shadow-lift-lg)]">
                <img
                  src={fig.src}
                  alt={fig.alt}
                  width="640"
                  height="427"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[3/2] w-full object-cover transition-transform duration-[1200ms]
                         [transition-timing-function:var(--ease-refined)] group-hover:scale-[1.03]"
                />
              </div>
              <figcaption class="mt-3 text-xs leading-relaxed text-stone-600">{fig.caption}</figcaption>
            </figure>
          ))}
        </div>
      </Reveal>

    </div>
  </Section>


  <!-- ══ PART THREE ══ -->
  <Section tone="stone" size="sm" class="!py-14 sm:!py-16">
    <div class="shell">
      <Reveal>
        <PartMarker
          part="Part Three"
          id="financial"
          title="Financial Stewardship"
          lede="Faith and financial responsibility are not opposing values. Every gift should be received with gratitude, administered with integrity, and connected to a clear purpose."
        />
      </Reveal>
    </div>
  </Section>

  <Section tone="ivory" labelledby="capital-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="capital-heading"
          eyebrow="Capital Planning"
          title="Preliminary planning ranges"
        />
      </Reveal>

      <div class="mt-12">
        <Prose>
          <p>
            The working capital target for acquisition of the existing lodge and a
            comprehensive renovation and operational setup is approximately
            <strong class="font-medium text-ink">$2.37 million to $2.73 million</strong>.
          </p>
          <p>
            The figures below are preliminary planning ranges rather than contractor
            bids. They will be replaced or refined after appraisal, inspection, survey,
            architectural development, engineering review, contractor pricing, and board
            approval.
          </p>
        </Prose>
      </div>

      <Reveal delay={80}>
        <CapitalTable />
      </Reveal>

      <ReviewNote label="Planning ranges, not bids">
        Mountain properties reveal structural, drainage and code conditions only after
        inspection. These figures will change as real information arrives, and we will
        tell our partners when they do.
      </ReviewNote>
    </div>
  </Section>

  <Section tone="linen" labelledby="pending-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="pending-heading"
          eyebrow="Still to Be Priced"
          title="We will not present an invented total"
        />
      </Reveal>
      <div class="mt-12">
        <Prose>
          <p>
            The worship pavilion, prayer garden, trails and site improvements may fall
            inside the renovation range or may need separate funding. Until they are
            properly priced, we will not publish an invented total.
          </p>
        </Prose>
      </div>
    </div>
  </Section>

  <Section tone="cream" labelledby="operating-heading">
    <div class="shell grid gap-14 lg:grid-cols-2 lg:gap-16">
      <Reveal>
        <h2 id="operating-heading" class="display-3">The annual operating budget</h2>
        <div class="rule-gold mt-6"></div>
        <p class="mt-7 text-[0.9375rem] leading-relaxed text-stone-700">
          Developed alongside the capital plan. Compensation and related-party
          arrangements will be documented and approved through appropriate governance.
          Any temporary housing, project management, or transitional costs connected to
          construction will be identified separately rather than hidden inside broad
          renovation categories.
        </p>
        <ul class="mt-8 space-y-3">
          {operating.map((item) => (
            <li class="flex items-start gap-3 text-[0.9375rem] text-ink">
              <span aria-hidden="true" class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-gold-500"></span>
              {item}
            </li>
          ))}
        </ul>
      </Reveal>

      <Reveal delay={120}>
        <h2 class="display-3">How the work may be funded</h2>
        <div class="rule-gold mt-6"></div>
        <p class="mt-7 text-[0.9375rem] leading-relaxed text-stone-700">
          Capital funding may include a combination of the following. Ongoing operations
          may be supported through donations, recurring partnerships, and properly
          documented support connected to the family’s marketplace work.
        </p>
        <ul class="mt-8 space-y-3">
          {funding.map((item) => (
            <li class="flex items-start gap-3 text-[0.9375rem] text-ink">
              <span aria-hidden="true" class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-bronze"></span>
              {item}
            </li>
          ))}
        </ul>
      </Reveal>
    </div>
  </Section>

  <Section tone="stone" labelledby="donor-heading">
    <div class="shell">
      <Reveal>
        <SectionHeading
          id="donor-heading"
          eyebrow="Donor Trust"
          title="Restricted gifts tracked for their stated purpose"
        />
      </Reveal>
      <div class="mt-12">
        <Prose>
          <p>
            All gifts designated for Ember Ridge will be received and administered
            through Firebrand Revivalists in accordance with its governing documents and
            applicable law. Restricted gifts will be tracked for their stated purpose,
            and financial reporting will be provided at a level appropriate to the
            project and the partner relationship.
          </p>
        </Prose>

        <Callout title="Tax status and receipting">
          <p>
            Firebrand Revivalists&#8482; is a Washington nonprofit corporation and a
            church for federal tax purposes, exempt under section 501(c)(3) of the
            Internal Revenue Code and excepted from the application requirement by
            section 508(c)(1)(A). Gifts are tax-deductible to the extent permitted by
            law, and giving receipts are provided. We do not offer tax advice — please
            consult your own advisor regarding your particular circumstances.
          </p>
        </Callout>

        <PullQuote cite="Psalm 127:1">
          Unless the Lord builds the house, those who build it labor in vain.
        </PullQuote>
      </div>
    </div>
  </Section>

  <CTASection
    eyebrow="Partner With Us"
    title="Help us build it well"
    body="A house like this is built in prayer long before it is built in timber and stone. Every figure above is published so that anyone considering a gift can see the reasoning behind it."
    primary={{ label: 'Ways to give', href: '/partner#give' }}
    secondary={{ label: 'Ask a question', href: '/contact' }}
  />
</BaseLayout>
