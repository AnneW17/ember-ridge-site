---
// src/components/PhotoBand.astro
// The single photographic band on the site. Framed rather than full-bleed, so it
// reads as a mounted plate on a light page.
interface Props {
  src: string;
  alt: string;
  caption: string;
  quote?: string;
  cite?: string;
  size?: 'short' | 'tall';
}
const { src, alt, caption, quote, cite } = Astro.props;
---
<section class="bg-ivory">
  <div class="shell py-16 sm:py-24">
    {quote && (
      <blockquote data-reveal class="mx-auto mb-12 max-w-3xl text-center">
        <p class="pullquote">{quote}</p>
        {cite && (
          <footer class="mt-5 font-sans text-xs uppercase tracking-[0.2em] text-gold-700">{cite}</footer>
        )}
      </blockquote>
    )}

    <figure data-reveal>
      <div class="overflow-hidden border border-stone-200 bg-cream shadow-[var(--shadow-lift-lg)]">
        <img
          src={src}
          alt={alt}
          width="1384"
          height="630"
          loading="lazy"
          decoding="async"
          class="w-full object-cover"
        />
      </div>
      <figcaption class="mt-4 flex items-start gap-3 text-xs leading-relaxed text-stone-600">
        <span aria-hidden="true" class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-gold-600"></span>
        {caption}
      </figcaption>
    </figure>
  </div>
</section>
