---
// src/components/ReviewNote.astro
// Visible marker for anything awaiting legal, financial or factual sign-off.
// Search the repo for "ReviewNote" to find every open item before launch.
interface Props { label?: string; }
const { label = 'Needs review' } = Astro.props;
---
<div class="review-note my-8" role="note">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="mt-1 shrink-0" aria-hidden="true">
    <path d="M12 9v4m0 3h.01M10.3 3.9 2.4 17.4A1.8 1.8 0 0 0 4 20h16a1.8 1.8 0 0 0 1.6-2.6L13.7 3.9a1.8 1.8 0 0 0-3.4 0Z"
      stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  </svg>
  <p>
    <strong class="font-semibold uppercase tracking-[0.1em]">{label}:</strong>
    <slot />
  </p>
</div>
